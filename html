  <div class="modal" style="max-width:360px;text-align:center;">
    <div style="font-size:40px;margin-bottom:10px;">🗑</div>
    <div class="modal-title" style="justify-content:center;" id="confirm-message">هل أنت متأكد؟</div>
    <div class="modal-actions" style="justify-content:center;">
      <button class="btn-cancel" onclick="closeConfirmModal()">إلغاء</button>
      <button class="btn-save" style="background:linear-gradient(135deg,#ef4444,#f59e0b);" onclick="confirmModalYes()">🗑 تأكيد الحذف</button>
    </div>
  </div>
</div>

<!-- Monthly Reset Modal -->
<div class="modal-overlay" id="monthly-reset-overlay" style="display:none;">
  <div class="modal" style="max-width:480px;text-align:center;">
    <div style="font-size:56px;margin-bottom:16px;animation:iconPulse 2s ease-in-out infinite;">🌙</div>
    <div class="modal-title" style="font-size:20px;justify-content:center;margin-bottom:8px;" id="reset-month-title">بداية شهر جديد!</div>
    <p style="font-size:13px;color:var(--text-muted);line-height:1.8;margin-bottom:20px;" id="reset-month-desc">
