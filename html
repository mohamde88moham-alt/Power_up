    if (document.getElementById('status-page-overlay').classList.contains('open')) {
      closeStatusPage();
    }
  }
  if (e.key === 'Enter' && document.getElementById('edit-modal-overlay').classList.contains('open')) {
    saveHabitEdit();
  }
  if (e.key === 'Enter' && document.getElementById('quick-edit-overlay').classList.contains('open')) {
    saveQuickEdit();
  }
});


// ============ PROGRESS CHART ============
let currentChartView = 'week';

function switchChartView(view, btn) {
  currentChartView = view;
  document.querySelectorAll('.chart-view-tab').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  renderProgressChart();
}

function getProgressData() {
  const data = { labels: [], values: [], total: 0, done: 0, best: 0, avg: 0 };

  if (currentChartView === 'week') {
    // Last 7 days
    for (let i = 6; i >= 0; i--) {
      const d = new Date(today);
      d.setDate(today.getDate() - i);
      const ds = formatDate(d);
      const done = habits.filter(h => getCheck(h.id, ds)).length;
      const total = habits.length;
      const pct = total > 0 ? Math.round((done / total) * 100) : 0;
      data.labels.push(`${DAYS_AR[(d.getDay() + 1) % 7]}\n${d.getDate()}`);
      data.values.push(pct);
      if (!isFuture(d)) { data.total++; data.done += done; }
    }
  } else if (currentChartView === 'month') {
    // Each day of current month
    const year = today.getFullYear(), month = today.getMonth();
    const daysInMonth = new Date(year, month + 1, 0).getDate();
    for (let day = 1; day <= daysInMonth; day++) {
      const d = new Date(year, month, day);
      const ds = formatDate(d);
      const done = habits.filter(h => getCheck(h.id, ds)).length;
      const total = habits.length;
      const pct = total > 0 ? Math.round((done / total) * 100) : 0;
      // Only label every 5 days to avoid crowding
      data.labels.push(day % 5 === 1 || day === daysInMonth ? String(day) : '');
      data.values.push(isFuture(d) ? null : pct);
      if (!isFuture(d)) { data.total++; data.done += done; }
    }
  } else {
    // year: each month
    const year = today.getFullYear();
    for (let m = 0; m < 12; m++) {
      const daysInMonth = new Date(year, m + 1, 0).getDate();
      let mDone = 0, mDays = 0;
      for (let day = 1; day <= daysInMonth; day++) {
        const d = new Date(year, m, day);
        if (isFuture(d)) continue;
        const ds = formatDate(d);
        const done = habits.filter(h => getCheck(h.id, ds)).length;
        const total = habits.length;
        if (total > 0) { mDone += done / total * 100; mDays++; }
      }
      const pct = mDays > 0 ? Math.round(mDone / mDays) : null;
      data.labels.push(MONTHS_AR[m].slice(0, 3));
      data.values.push(pct);
      if (pct !== null) { data.total++; data.done += (pct / 100); }
    }
  }

  const validVals = data.values.filter(v => v !== null);
  data.best = validVals.length > 0 ? Math.max(...validVals) : 0;
  data.avg = validVals.length > 0 ? Math.round(validVals.reduce((a, b) => a + b, 0) / validVals.length) : 0;
  return data;
}

function renderProgressChart() {
  const data = getProgressData();
  renderSummaryCards(data);
  renderSVGChart(data);
  renderLegend();
}

function renderSummaryCards(data) {
  const validVals = data.values.filter(v => v !== null);
  const avg = data.avg;
  const best = data.best;
  const doneCount = validVals.filter(v => v >= 80).length;

  const viewLabel = currentChartView === 'week' ? 'الأسبوع' : currentChartView === 'month' ? 'الشهر' : 'السنة';

  document.getElementById('chart-summary-cards').innerHTML = `
    <div class="chart-sum-card" style="--sum-color:#00c8ff;">
      <div class="sum-label">متوسط ${viewLabel}</div>
      <div class="sum-value">${avg}%</div>
      <div class="sum-sub">معدل الإنجاز</div>
    </div>
    <div class="chart-sum-card" style="--sum-color:#10b981;">
      <div class="sum-label">أفضل يوم</div>
      <div class="sum-value">${best}%</div>
      <div class="sum-sub">أعلى إنجاز</div>
    </div>
    <div class="chart-sum-card" style="--sum-color:#f59e0b;">
      <div class="sum-label">أيام ممتازة</div>
      <div class="sum-value">${doneCount}</div>
      <div class="sum-sub">فوق 80%</div>
    </div>
  `;
}

function renderSVGChart(data) {
  const svg = document.getElementById('progress-svg');
  const W = 900, H = 220;
  const padL = 36, padR = 16, padT = 16, padB = 36;
  const chartW = W - padL - padR;
  const chartH = H - padT - padB;

  const vals = data.values;
  const n = vals.length;

  // points (skip nulls)
  const points = [];
  vals.forEach((v, i) => {
    if (v === null) return;
    const x = padL + (n === 1 ? chartW / 2 : (i / (n - 1)) * chartW);
    const y = padT + chartH - (v / 100) * chartH;
    points.push({ x, y, v, i, label: data.labels[i] });
  });

  // Build polyline path
  const linePath = points.map((p, idx) => `${idx === 0 ? 'M' : 'L'}${p.x.toFixed(1)},${p.y.toFixed(1)}`).join(' ');
  const areaPath = points.length > 0
    ? `${linePath} L${points[points.length - 1].x.toFixed(1)},${(padT + chartH).toFixed(1)} L${points[0].x.toFixed(1)},${(padT + chartH).toFixed(1)} Z`
    : '';

  // Grid lines (0, 25, 50, 75, 100)
  let gridHtml = '';
  [0, 25, 50, 75, 100].forEach(pct => {
    const y = padT + chartH - (pct / 100) * chartH;
    gridHtml += `<line class="chart-grid-line" x1="${padL}" y1="${y.toFixed(1)}" x2="${W - padR}" y2="${y.toFixed(1)}"/>`;
    gridHtml += `<text class="chart-axis-label" x="${padL - 4}" y="${(y + 4).toFixed(1)}" text-anchor="end">${pct}</text>`;
  });

  // X axis labels
  let xLabels = '';
  const labelStep = Math.max(1, Math.floor(n / 12));
  data.labels.forEach((lbl, i) => {
    if (!lbl) return;
    const x = padL + (n === 1 ? chartW / 2 : (i / (n - 1)) * chartW);
    const lines = lbl.split('\n');
    lines.forEach((line, li) => {
      xLabels += `<text class="chart-axis-label" x="${x.toFixed(1)}" y="${(padT + chartH + 14 + li * 12).toFixed(1)}" text-anchor="middle">${line}</text>`;
    });
  });

  // Dots with tooltip triggers
  let dotsHtml = '';
  points.forEach(p => {
    dotsHtml += `<circle class="chart-dot" cx="${p.x.toFixed(1)}" cy="${p.y.toFixed(1)}" r="4"
      fill="${p.v >= 80 ? '#10b981' : p.v >= 50 ? '#00c8ff' : p.v >= 25 ? '#f59e0b' : '#ef4444'}"
      stroke="var(--bg)" stroke-width="2"
      onmouseenter="showChartTooltip(event, '${p.label.replace(/\n/,' ')}', ${p.v})"
      onmouseleave="hideChartTooltip()"/>`;
  });

  // Gradient defs
  const gradDef = `<defs>
    <linearGradient id="lineGrad" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#00c8ff"/>
      <stop offset="50%" stop-color="#7c3aed"/>
      <stop offset="100%" stop-color="#10b981"/>
    </linearGradient>
    <linearGradient id="areaGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#00c8ff" stop-opacity="0.4"/>
      <stop offset="100%" stop-color="#00c8ff" stop-opacity="0"/>
    </linearGradient>
  </defs>`;

  // Average line
  const avgY = padT + chartH - (data.avg / 100) * chartH;
  const avgLine = data.avg > 0 ? `
    <line x1="${padL}" y1="${avgY.toFixed(1)}" x2="${W - padR}" y2="${avgY.toFixed(1)}"
      stroke="#f59e0b" stroke-width="1.5" stroke-dasharray="6,4" opacity="0.6"/>
    <text class="chart-axis-label" x="${W - padR + 2}" y="${(avgY + 4).toFixed(1)}" fill="#f59e0b" font-size="9">متوسط</text>
  ` : '';

  svg.innerHTML = `
    ${gradDef}
    ${gridHtml}
    ${xLabels}
    ${areaPath ? `<path d="${areaPath}" fill="url(#areaGrad)" class="chart-area-path"/>` : ''}
    ${linePath ? `<path d="${linePath}" class="chart-line-path" stroke="url(#lineGrad)"/>` : ''}
    ${avgLine}
    ${dotsHtml}
  `;
}

function renderLegend() {
  document.getElementById('chart-legend').innerHTML = `
    <div class="legend-item"><div class="legend-dot" style="background:#10b981;"></div> ممتاز (≥80%)</div>
    <div class="legend-item"><div class="legend-dot" style="background:#00c8ff;"></div> جيد (50–79%)</div>
    <div class="legend-item"><div class="legend-dot" style="background:#f59e0b;"></div> مقبول (25–49%)</div>
    <div class="legend-item"><div class="legend-dot" style="background:#ef4444;"></div> ضعيف (<25%)</div>
    <div class="legend-item" style="margin-right:auto;">
      <div style="width:22px;height:2px;background:#f59e0b;border-top:2px dashed #f59e0b;opacity:0.7;"></div>
      خط المتوسط
    </div>
  `;
}

function showChartTooltip(e, label, value) {
  const tt = document.getElementById('chart-tooltip');
  document.getElementById('tt-label').textContent = label;
  document.getElementById('tt-value').textContent = value + '%';
  tt.style.color = value >= 80 ? '#10b981' : value >= 50 ? '#00c8ff' : value >= 25 ? '#f59e0b' : '#ef4444';
  document.getElementById('tt-value').style.color = tt.style.color;

  const wrap = tt.parentElement.getBoundingClientRect();
  const svgEl = document.getElementById('progress-svg');
  const svgRect = svgEl.getBoundingClientRect();
  const ex = e.clientX - svgRect.left;
  const ey = e.clientY - svgRect.top;
  tt.style.left = ex + 'px';
  tt.style.top = ey + 'px';
  tt.classList.add('visible');
}

function hideChartTooltip() {
  document.getElementById('chart-tooltip').classList.remove('visible');
}

// ============ OVERVIEW SECTION ============
function renderOverview() {
  renderOverallStats();
  renderAnalysisTable();
