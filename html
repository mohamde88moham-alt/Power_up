// ============ STREAKS ============
function calcStreaks() {
  habits.forEach(h => {
    let streak = 0;
    let d = new Date(today);
    while (true) {
      const ds = formatDate(d);
      if (getCheck(h.id, ds)) {
        streak++;
        d.setDate(d.getDate() - 1);
      } else break;
    }
    h.streak = streak;
  });
}

// ============ STATS ============
function updateStats() {
  const todayStr = formatDate(today);
  const done = habits.filter(h => getCheck(h.id, todayStr)).length;
  const total = habits.length;
  const pct = total > 0 ? Math.round((done/total)*100) : 0;

  document.getElementById('total-done').textContent = done;

  // Streak
  const maxStreak = Math.max(...habits.map(h=>h.streak), 0);
  document.getElementById('best-streak').textContent = maxStreak;

  // Week
  const dates = getWeekDates(0);
  let weekDone=0, weekTotal=0;
  dates.forEach(d => {
    const ds = formatDate(d);
    if (!isFuture(d)) {
      habits.forEach(h => {
        weekTotal++;
        if (getCheck(h.id, ds)) weekDone++;
      });
    }
  });
  const weekPct = weekTotal>0 ? Math.round((weekDone/weekTotal)*100) : 0;
  document.getElementById('week-pct').textContent = weekPct+'%';

  // Month
  const year = today.getFullYear(), month = today.getMonth();
  const daysInMonth = new Date(year, month+1, 0).getDate();
  let mDone=0, mTotal=0;
  for (let day=1; day<=today.getDate(); day++) {
    const d = new Date(year, month, day);
    const ds = formatDate(d);
    habits.forEach(h => {
      mTotal++;
      if (getCheck(h.id, ds)) mDone++;
    });
  }
  const mPct = mTotal>0 ? Math.round((mDone/mTotal)*100) : 0;
  document.getElementById('month-pct').textContent = mPct+'%';

  // Ring
  const ring = document.getElementById('progress-ring');
  const offset = 314 - (314 * pct / 100);
  ring.style.strokeDashoffset = offset;
  document.getElementById('ring-pct').textContent = pct+'%';
}

// ============ CHART ============
function renderChartBars() {
  const container = document.getElementById('chart-bars');
  const tabs = document.getElementById('week-tabs');
  const dates = getWeekDates(currentWeek);

  let html = '';
  dates.forEach((d, i) => {
    const ds = formatDate(d);
    const done = habits.filter(h => getCheck(h.id, ds)).length;
    const total = habits.length;
    const pct = total > 0 ? (done/total)*100 : 0;
    const highlight = isToday(d);
    html += `<div class="chart-bar-wrap">
      <div class="chart-bar-col">
        <div class="chart-bar-inner" style="height:${pct}%;background:${highlight?'linear-gradient(to top, #00c8ff, rgba(0,200,255,0.4))':'linear-gradient(to top, rgba(0,200,255,0.5), rgba(0,200,255,0.1))'};"></div>
      </div>
      <div class="chart-label">${DAYS_EN[i]}</div>
    </div>`;
  });
  container.innerHTML = html;

  // Week tabs
  let tabHtml = '';
  for (let w=-3; w<=0; w++) {
    tabHtml += `<button class="month-tab ${w===currentWeek?'active':''}" onclick="currentWeek=${w};renderAll()">
      ${w===0?'هذا الأسبوع':w===-1?'الماضي':`-${Math.abs(w)} أسابيع`}
    </button>`;
  }
  tabs.innerHTML = tabHtml;
}

