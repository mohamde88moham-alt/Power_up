    </div>

    <div class="modal-actions" style="justify-content:center;gap:12px;">
      <button class="btn-cancel" onclick="closeResetModal()" style="min-width:120px;">لاحقاً</button>
      <button class="btn-save" onclick="confirmMonthlyReset()" style="min-width:160px;background:linear-gradient(135deg,var(--accent3),#059669);">🚀 ابدأ الشهر الجديد</button>
    </div>
  </div>
</div>

<!-- Toast -->
<div class="toast" id="toast">✅ تم الحفظ</div>

<!-- ============ STATUS PAGE (isolated full-screen page) ============ -->
<div class="status-page-overlay" id="status-page-overlay" onclick="closeStatusPage(event)">
  <div class="status-page-particles" id="status-page-particles"></div>
  <div class="status-page-scanline" id="status-page-scanline"></div>

  <div class="status-page-card" onclick="event.stopPropagation()">
    <span class="status-corner tl"></span>
    <span class="status-corner tr"></span>
    <span class="status-corner bl"></span>
    <span class="status-corner br"></span>

    <div class="status-page-topbar status-reveal r1">
      <button class="status-page-back" onclick="closeStatusPage()">→ رجوع</button>
      <div class="status-page-heading">STATUS<span>شاشة حالة الشخصية</span></div>
    </div>

    <div class="status-page-body">
      <!-- LEFT: identity + xp + stats + distribute -->
