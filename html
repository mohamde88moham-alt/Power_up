<div class="modal-overlay" id="quick-edit-overlay" onclick="closeQuickEdit(event)">
  <div class="modal" style="max-width:380px;">
    <div class="modal-title" id="quick-edit-title">تعديل</div>

    <div class="modal-field" id="quick-edit-field1-wrap">
      <label class="modal-label" id="quick-edit-label1">الاسم</label>
      <input type="text" class="modal-input" id="quick-edit-input1" placeholder="">
    </div>

    <div class="modal-field" id="quick-edit-field2-wrap" style="display:none;">
