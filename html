  </header>

  <!-- STATS -->
  <div class="stats-grid">
    <div class="stat-card" style="--card-color: #00c8ff;">
      <div class="stat-trend" id="stat-trend-1">↑ 12%</div>
      <div class="stat-icon">🎯</div>
      <div class="stat-value" id="total-done">0</div>
      <div class="stat-label">إجمالي الإنجازات اليوم</div>
    </div>
    <div class="stat-card" style="--card-color: #10b981;">
      <div class="stat-trend" id="stat-trend-2">↑ 5%</div>
      <div class="stat-icon">🔥</div>
      <div class="stat-value" id="best-streak">0</div>
      <div class="stat-label">أطول سلسلة انجاز</div>
    </div>
    <div class="stat-card" style="--card-color: #f59e0b;">
      <div class="stat-icon">📅</div>
      <div class="stat-value" id="week-pct">0%</div>
      <div class="stat-label">نسبة الأسبوع الحالي</div>
    </div>
    <div class="stat-card" style="--card-color: #7c3aed;">
      <div class="stat-icon">✨</div>
      <div class="stat-value" id="month-pct">0%</div>
      <div class="stat-label">نسبة الشهر</div>
    </div>
  </div>

  <!-- MAIN -->
  <div class="main-layout">

    <!-- SIDEBAR -->
    <div class="sidebar">

      <!-- Ring Progress -->
      <div class="panel">
        <div class="panel-title">تقدم اليوم</div>
        <div class="ring-container">
          <svg width="120" height="120" viewBox="0 0 120 120">
            <circle cx="60" cy="60" r="50" fill="none" stroke="rgba(255,255,255,0.05)" stroke-width="10"/>
            <circle cx="60" cy="60" r="50" fill="none" stroke="url(#ringGrad)" stroke-width="10"
              stroke-linecap="round"
              stroke-dasharray="314"
              stroke-dashoffset="314"
              transform="rotate(-90 60 60)"
              id="progress-ring"
              style="transition: stroke-dashoffset 1s ease;"/>
            <defs>
              <linearGradient id="ringGrad" x1="0%" y1="0%" x2="100%" y2="0%">
                <stop offset="0%" stop-color="#00c8ff"/>
                <stop offset="100%" stop-color="#7c3aed"/>
              </linearGradient>
            </defs>
          </svg>
          <div class="ring-label">
            <div class="ring-pct" id="ring-pct">0%</div>
            <div class="ring-sub">اليوم</div>
          </div>
        </div>
      </div>

      <!-- AI Insights -->
      <div class="panel">
        <div class="panel-title">تحليل الذكاء الاصطناعي</div>
        <div id="ai-insights">
          <div class="insight-item">
            <div class="insight-emoji">🧠</div>
            <div class="insight-text">اضغط على <strong>"تحليل AI"</strong> لتحليل عاداتك وتقديم توصيات مخصصة.</div>
          </div>
        </div>
        <button class="btn btn-primary" style="width:100%; margin-top:10px; font-size:13px;" onclick="getAIInsights()">
          🤖 تحليل AI
        </button>
      </div>

    </div>

    <!-- TRACKER TABLE -->
    <div class="tracker-panel">
      <div class="tracker-header">
        <div class="tracker-title">
          📋 متتبع العادات الأسبوعي
        </div>
        <div class="week-nav">
          <button onclick="changeWeek(-1)">◀</button>
          <div class="week-label" id="week-label">الأسبوع 1</div>
          <button onclick="changeWeek(1)">▶</button>
        </div>
      </div>

      <div class="table-wrap">
        <table>
          <thead id="table-head"></thead>
          <tbody id="table-body"></tbody>
        </table>
      </div>

      <!-- Add habit -->
      <div class="add-habit-row">
        <input type="text" class="add-habit-input" id="new-habit-input" placeholder="✏️ اكتب عادة جديدة واضغط Enter..." onkeydown="handleAddHabit(event)">
        <button class="btn btn-primary" style="padding:10px 16px; font-size:13px;" onclick="addHabitFromInput()">إضافة</button>
      </div>
    </div>
  </div>

  <!-- BOTTOM -->
  <div class="bottom-layout">

    <!-- Chart -->
    <div class="panel">
      <div class="panel-title">تحليل الأداء الأسبوعي</div>
      <div class="month-tabs" id="week-tabs"></div>
      <div class="chart-bars" id="chart-bars"></div>
    </div>

    <!-- AI Chat -->
    <div class="panel" style="display:flex; flex-direction:column;">
      <div class="panel-title">🤖 مساعد الذكاء الاصطناعي</div>
      <div class="ai-chat-area" id="ai-chat"></div>
      <div class="ai-input-row">
        <input type="text" class="ai-input" id="ai-input-field" placeholder="اسأل الذكاء الاصطناعي عن عاداتك..." onkeydown="if(event.key==='Enter') sendAIMessage()">
        <button class="send-btn" id="send-btn" onclick="sendAIMessage()">➤</button>
      </div>
    </div>

  </div>
  
  <!-- PROGRESS CHARTS SECTION -->
  <div class="progress-section">
    <div class="panel">
      <div class="chart-header">
        <div class="panel-title" style="margin-bottom:0;">📊 مبيان التقدم التفصيلي</div>
        <div class="chart-view-tabs">
          <button class="chart-view-tab active" onclick="switchChartView('week', this)">الأسبوع</button>
          <button class="chart-view-tab" onclick="switchChartView('month', this)">الشهر</button>
          <button class="chart-view-tab" onclick="switchChartView('year', this)">السنة</button>
        </div>
      </div>
      <div class="chart-summary" id="chart-summary-cards"></div>
      <div class="line-chart-wrap">
        <svg class="chart-svg" id="progress-svg" viewBox="0 0 900 220" preserveAspectRatio="none"></svg>
        <div class="chart-tooltip" id="chart-tooltip">
          <div id="tt-label" style="font-size:11px;color:var(--text-muted);margin-bottom:2px;"></div>
          <div id="tt-value" class="tooltip-value"></div>
        </div>
      </div>
      <div class="chart-legend" id="chart-legend"></div>
    </div>
  </div>

  <!-- OVERVIEW: Overall Stats + Analysis Table + Top Habits -->
  <div class="overview-section">

    <!-- Overall Stats Donut -->
    <div class="overall-stats-card">
      <div class="overall-title">Overall Stats</div>
      <div class="donut-wrap">
        <svg viewBox="0 0 130 130">
          <circle cx="65" cy="65" r="52" fill="none" stroke="rgba(255,255,255,0.05)" stroke-width="12"/>
          <!-- Completed arc -->
          <circle cx="65" cy="65" r="52" fill="none" stroke="url(#donutGrad1)" stroke-width="12"
            stroke-linecap="round"
            stroke-dasharray="326.73"
            stroke-dashoffset="326.73"
            transform="rotate(-90 65 65)"
            id="overall-donut-done"
            style="transition: stroke-dashoffset 1.2s ease;"/>
          <!-- Remaining arc -->
          <circle cx="65" cy="65" r="52" fill="none" stroke="rgba(124,58,237,0.25)" stroke-width="12"
            stroke-linecap="round"
            stroke-dasharray="326.73"
            stroke-dashoffset="326.73"
            transform="rotate(-90 65 65)"
            id="overall-donut-left"
            style="transition: stroke-dashoffset 1.2s ease;"/>
          <defs>
            <linearGradient id="donutGrad1" x1="0%" y1="0%" x2="100%" y2="0%">
              <stop offset="0%" stop-color="#00c8ff"/>
              <stop offset="100%" stop-color="#10b981"/>
            </linearGradient>
          </defs>
        </svg>
        <div class="donut-center">
          <div class="donut-pct" id="overall-pct">0%</div>
          <div class="donut-sub">إجمالي</div>
        </div>
      </div>
      <div class="overall-meta">
        <div class="meta-item">
          <div class="meta-val" id="ov-goal">0</div>
          <div class="meta-lbl">الهدف</div>
        </div>
        <div class="meta-item">
          <div class="meta-val" style="color:var(--accent3);" id="ov-done">0</div>
          <div class="meta-lbl">مكتمل</div>
        </div>
        <div class="meta-item">
          <div class="meta-val" style="color:var(--accent4);" id="ov-left">0</div>
          <div class="meta-lbl">متبقي</div>
        </div>
        <div class="meta-item">
          <div class="meta-val" style="color:var(--accent2);" id="ov-streak">0</div>
          <div class="meta-lbl">أيام</div>
        </div>
      </div>
    </div>

    <!-- Analysis Table -->
    <div class="analysis-card">
      <div class="analysis-head">📋 تحليل أداء العادات (الشهر الحالي)</div>
      <div style="overflow-x:auto; max-height:320px; overflow-y:auto;">
        <table class="analysis-table">
          <thead>
            <tr>
              <th>العادة</th>
              <th>الهدف</th>
              <th>المنجز</th>
              <th>المتبقي</th>
              <th colspan="2">التقدم</th>
            </tr>
          </thead>
          <tbody id="analysis-tbody"></tbody>
        </table>
      </div>
    </div>

    <!-- Top 10 Habits -->
    <div class="top-habits-card">
      <div class="top-habits-head">🏆 TOP DAILY HABITS</div>
      <div class="top-habits-list" id="top-habits-list"></div>
    </div>

  </div>

  <!-- SUB-TASKS SECTION -->
  <div class="subtasks-section">
    <div class="panel-title" style="margin-bottom:16px;">📌 المهام الثانوية اليومية</div>
    <div class="subtasks-grid">

      <!-- Board 1: اليوم -->
      <div class="subtask-board board-1" id="subtask-board-1">
        <div class="subtask-board-header">
          <div class="subtask-board-title">
            <div class="board-icon">⚡</div>
            مهام اليوم
          </div>
          <span class="subtask-count-badge" id="st-badge-1">0 / 0</span>
        </div>
        <div class="subtask-progress-bar"><div class="subtask-progress-fill" id="st-prog-1" style="width:0%"></div></div>
        <div class="subtask-stats-row">
          <span class="subtask-stat-pill pill-done">✓ <span id="st-done-1">0</span> مكتمل</span>
          <span class="subtask-stat-pill pill-pending">⏳ <span id="st-pending-1">0</span> متبقي</span>
          <span class="pill-pct" id="st-pct-1">0%</span>
        </div>
        <div class="subtask-list" id="subtask-list-1"></div>
        <div class="subtask-add-row">
          <input type="text" class="subtask-input" id="st-input-1" placeholder="✏️ أضف مهمة جديدة..." onkeydown="if(event.key==='Enter') addSubtask(1)">
          <select class="subtask-priority-select" id="st-priority-1">
            <option value="high">🔴 عاجل</option>
            <option value="med" selected>🟡 متوسط</option>
            <option value="low">🟢 منخفض</option>
          </select>
          <button class="subtask-add-btn" onclick="addSubtask(1)">+</button>
        </div>
      </div>

      <!-- Board 2: هذا الأسبوع -->
      <div class="subtask-board board-2" id="subtask-board-2">
        <div class="subtask-board-header">
          <div class="subtask-board-title">
            <div class="board-icon">🗓</div>
            مهام الأسبوع
          </div>
          <span class="subtask-count-badge" id="st-badge-2">0 / 0</span>
        </div>
        <div class="subtask-progress-bar"><div class="subtask-progress-fill" id="st-prog-2" style="width:0%"></div></div>
        <div class="subtask-stats-row">
          <span class="subtask-stat-pill pill-done">✓ <span id="st-done-2">0</span> مكتمل</span>
          <span class="subtask-stat-pill pill-pending">⏳ <span id="st-pending-2">0</span> متبقي</span>
          <span class="pill-pct" id="st-pct-2">0%</span>
        </div>
        <div class="subtask-list" id="subtask-list-2"></div>
        <div class="subtask-add-row">
          <input type="text" class="subtask-input" id="st-input-2" placeholder="✏️ أضف مهمة جديدة..." onkeydown="if(event.key==='Enter') addSubtask(2)">
          <select class="subtask-priority-select" id="st-priority-2">
            <option value="high">🔴 عاجل</option>
            <option value="med" selected>🟡 متوسط</option>
            <option value="low">🟢 منخفض</option>
          </select>
          <button class="subtask-add-btn" onclick="addSubtask(2)">+</button>
        </div>
      </div>

    </div>
  </div>

</div>
<div class="modal-overlay" id="edit-modal-overlay" onclick="closeEditModal(event)">
  <div class="modal">
    <div class="modal-title">✏️ تعديل العادة</div>

    <div class="modal-field">
      <label class="modal-label">اسم العادة</label>
      <input type="text" class="modal-input" id="edit-habit-name" placeholder="أدخل اسم العادة...">
    </div>

    <div class="modal-field">
      <label class="modal-label">الإيموجي المختار</label>
      <div class="emoji-preview">
        <span class="emoji-preview-icon" id="edit-emoji-preview">⭐</span>
        <span>الإيموجي الحالي — اختر من القائمة أدناه</span>
