          </div>
        </div>

        <div class="status-divider status-reveal r3"></div>

        <div class="status-stats-grid status-reveal r3" id="status-stats-grid"></div>

        <div class="status-points-bar status-reveal r4">
          <span>نقاط متاحة للتوزيع</span>
          <span class="status-points-num" id="status-points">0</span>
        </div>

        <div class="status-distribute status-reveal r4" id="status-distribute"></div>
      </div>

      <!-- RIGHT: skills -->
      <div class="status-page-col">
        <div class="status-page-skills-panel status-reveal r5">
          <div class="status-skills-head">🎯 المهارات</div>
          <div class="status-skills-list" id="status-skills-list"></div>
          <button class="status-add-skill-btn" onclick="addSkill()">+ إضافة مهارة</button>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
// ============ STATE ============
const DAYS_AR = ['السبت','الأحد','الإثنين','الثلاثاء','الأربعاء','الخميس','الجمعة'];
const DAYS_EN = ['Sa','Su','Mo','Tu','We','Th','Fr'];
const MONTHS_AR = ['يناير','فبراير','مارس','أبريل','مايو','يونيو','يوليو','أغسطس','سبتمبر','أكتوبر','نوفمبر','ديسمبر'];

let habits = JSON.parse(localStorage.getItem('habits') || 'null') || [
  { id:1, name:'الاستيقاظ 5:00 صباحاً', emoji:'⏰', streak:0, color:'#f59e0b' },
  { id:2, name:'التمرين الرياضي', emoji:'💪', streak:0, color:'#10b981' },
  { id:3, name:'التأمل والتنفس', emoji:'🧘', streak:0, color:'#7c3aed' },
  { id:4, name:'تخطيط اليوم', emoji:'📝', streak:0, color:'#00c8ff' },
  { id:5, name:'لا سكر', emoji:'🚫', streak:0, color:'#ef4444' },
  { id:6, name:'النوم 10:00 مساءً', emoji:'😴', streak:0, color:'#6366f1' },
];

let checks = JSON.parse(localStorage.getItem('checks') || '{}');
let currentWeek = 0; // 0 = current week
const today = new Date();
let nextId = Math.max(...habits.map(h=>h.id), 0) + 1;

// Chat history
let chatHistory = [];

// ============ MONTHLY RESET ============
function getMonthKey(date) {
  return `${date.getFullYear()}-${String(date.getMonth()+1).padStart(2,'0')}`;
}

function checkMonthlyReset() {
  const currentMonthKey = getMonthKey(today);
  const lastActiveMonth = localStorage.getItem('lastActiveMonth');

  // First ever visit: just save current month, no reset needed
  if (!lastActiveMonth) {
    localStorage.setItem('lastActiveMonth', currentMonthKey);
    return;
  }

  // Same month: nothing to do
  if (lastActiveMonth === currentMonthKey) return;

  // New month detected → compute last month summary and show modal
  const [ly, lm] = lastActiveMonth.split('-').map(Number);
  const lastMonthDate = new Date(ly, lm - 1, 1);
  const lastMonthDays = new Date(ly, lm, 0).getDate();

  let totalDone = 0, totalPossible = 0, maxStreak = 0;
  for (let day = 1; day <= lastMonthDays; day++) {
    const d = new Date(ly, lm - 1, day);
    const ds = formatDate(d);
    habits.forEach(h => {
      totalPossible++;
      if (getCheck(h.id, ds)) totalDone++;
    });
  }
  // Recompute max streak from last month data
  habits.forEach(h => {
    let streak = 0, best = 0;
    for (let day = 1; day <= lastMonthDays; day++) {
      const ds = formatDate(new Date(ly, lm - 1, day));
      if (getCheck(h.id, ds)) { streak++; best = Math.max(best, streak); }
      else streak = 0;
    }
    maxStreak = Math.max(maxStreak, best);
  });
  const pct = totalPossible > 0 ? Math.round((totalDone / totalPossible) * 100) : 0;

  // Save archive
  const archive = JSON.parse(localStorage.getItem('monthsArchive') || '[]');
  archive.push({
    month: lastActiveMonth,
    label: `${MONTHS_AR[lm-1]} ${ly}`,
    totalDone, totalPossible, pct, maxStreak,
    habits: habits.map(h => ({ id: h.id, name: h.name, emoji: h.emoji }))
  });
  localStorage.setItem('monthsArchive', JSON.stringify(archive));

  // Fill modal
  document.getElementById('reset-month-title').textContent = `بداية ${MONTHS_AR[today.getMonth()]} ${today.getFullYear()} 🎯`;
  document.getElementById('reset-month-desc').innerHTML =
    `انتهى شهر <strong style="color:var(--accent)">${MONTHS_AR[lm-1]} ${ly}</strong> — حان وقت بداية جديدة ✨<br>
     العادات تبقى كما هي، فقط البيانات اليومية تُعاد للصفر.`;
  document.getElementById('reset-stat-done').textContent = totalDone;
  document.getElementById('reset-stat-pct').textContent = pct + '%';
  document.getElementById('reset-stat-streak').textContent = maxStreak;

  // Show modal
  document.getElementById('monthly-reset-overlay').style.display = 'flex';
}

function confirmMonthlyReset() {
  // Clear only check data (keep habits list, subtasks, etc.)
  checks = {};
  localStorage.setItem('checks', JSON.stringify(checks));

  // Reset streaks
  habits.forEach(h => h.streak = 0);
  save();

  // Mark new month
  localStorage.setItem('lastActiveMonth', getMonthKey(today));

  closeResetModal();
  showToast('🚀 تم إعادة تعيين الشهر بنجاح!');
  renderAll();
}

function closeResetModal() {
  document.getElementById('monthly-reset-overlay').style.display = 'none';
  // Even if dismissed, mark month so it doesn't show again this month
  localStorage.setItem('lastActiveMonth', getMonthKey(today));
}

// ============ HELPERS ============
function getWeekDates(offset=0) {
  const dates = [];
  const now = new Date(today);
  // Find Saturday (start of week in Arabic calendar)
  const day = now.getDay();
  // 0=Sun,1=Mon,...,6=Sat
  const diffToSat = (day === 6) ? 0 : -(day + 1);
  const sat = new Date(now);
  sat.setDate(now.getDate() + diffToSat + (offset * 7));
  for (let i = 0; i < 7; i++) {
    const d = new Date(sat);
    d.setDate(sat.getDate() + i);
    dates.push(d);
  }
  return dates;
}

function formatDate(d) {
  return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`;
}

function isToday(d) { return formatDate(d) === formatDate(today); }
function isFuture(d) { return d > today && !isToday(d); }

function getCheck(habitId, dateStr) {
  return !!(checks[`${habitId}_${dateStr}`]);
}

function setCheck(habitId, dateStr, val) {
  if (val) checks[`${habitId}_${dateStr}`] = true;
  else delete checks[`${habitId}_${dateStr}`];
  localStorage.setItem('checks', JSON.stringify(checks));
}

function save() {
  localStorage.setItem('habits', JSON.stringify(habits));
  localStorage.setItem('checks', JSON.stringify(checks));
}

// ============ STATUS / RPG SYSTEM ============
const STAT_KEYS = ['STR', 'AGI', 'PER', 'VIT', 'INT', 'LUK'];

const DEFAULT_STATS_META = {
  STR: { label: 'STR', icon: '💪' },
  AGI: { label: 'AGI', icon: '⚡' },
  PER: { label: 'PER', icon: '👁️' },
  VIT: { label: 'VIT', icon: '❤️' },
  INT: { label: 'INT', icon: '🧠' },
  LUK: { label: 'LUK', icon: '🍀' },
};

const XP_PER_HABIT = 15;

let character = JSON.parse(localStorage.getItem('character') || 'null') || {
  level: 1,
  xp: 0,
  xpToNext: 100,
  job: 'None',
  title: 'مبتدئ',
  points: 0,
  statsMeta: JSON.parse(JSON.stringify(DEFAULT_STATS_META)),
  statsBase: { STR: 10, AGI: 10, PER: 10, VIT: 10, INT: 10, LUK: 0 },
  statsSpent: { STR: 0, AGI: 0, PER: 0, VIT: 0, INT: 0, LUK: 0 },
  skills: [
    { id: 1, name: 'فن اللامبالاة' },
    { id: 2, name: 'بيع أي شيء' },
  ],
};

// Migrate characters saved by older versions of this file (drop hp/mp,
// backfill statsMeta if missing).
(function normalizeCharacter() {
  if (!character.statsMeta) character.statsMeta = JSON.parse(JSON.stringify(DEFAULT_STATS_META));
  STAT_KEYS.forEach(key => {
    if (!character.statsMeta[key]) character.statsMeta[key] = { ...DEFAULT_STATS_META[key] };
  });
  delete character.hp;
  delete character.hpMax;
  delete character.mp;
  delete character.mpMax;
  localStorage.setItem('character', JSON.stringify(character));
})();

let nextSkillId = Math.max(0, ...character.skills.map(s => s.id)) + 1;

// Tracks which habit/date cells already granted XP, so unchecking/rechecking
// the same cell never farms XP twice.
let xpAwardedCells = JSON.parse(localStorage.getItem('xpAwardedCells') || '{}');

// Which stat / skill row currently has its edit controls revealed (tap to
// reveal, tap again or edit/delete to hide).
let revealedStat = null;
let revealedSkillId = null;

// ============ QUICK EDIT MODAL (replaces prompt/confirm, which are
// blocked inside sandboxed preview frames) ============
let quickEditContext = null;

function openQuickEdit(opts) {
  quickEditContext = opts;
  document.getElementById('quick-edit-title').textContent = opts.title;

  document.getElementById('quick-edit-label1').textContent = opts.label1;
  const input1 = document.getElementById('quick-edit-input1');
  input1.value = opts.value1 || '';
  input1.placeholder = opts.placeholder1 || '';

  const field2 = document.getElementById('quick-edit-field2-wrap');
  if (opts.label2) {
    document.getElementById('quick-edit-label2').textContent = opts.label2;
    const input2 = document.getElementById('quick-edit-input2');
    input2.value = opts.value2 || '';
    input2.placeholder = opts.placeholder2 || '';
    field2.style.display = '';
  } else {
    field2.style.display = 'none';
  }

  document.getElementById('quick-edit-overlay').classList.add('open');
  setTimeout(() => { input1.focus(); input1.select(); }, 50);
}

function closeQuickEdit(e) {
  if (e && e.target !== document.getElementById('quick-edit-overlay')) return;
  document.getElementById('quick-edit-overlay').classList.remove('open');
  quickEditContext = null;
}

function saveQuickEdit() {
  if (!quickEditContext) return;
  const v1 = document.getElementById('quick-edit-input1').value.trim();
  const v2 = document.getElementById('quick-edit-input2').value.trim();
  const { type, payload } = quickEditContext;

  if (type === 'job') {
    character.job = v1 || 'None';
  } else if (type === 'title') {
    character.title = v1 || 'مبتدئ';
  } else if (type === 'addSkill') {
    if (!v1) { closeQuickEdit(); return; }
    character.skills.push({ id: nextSkillId++, name: v1 });
    showToast('✅ تمت إضافة المهارة');
  } else if (type === 'editSkill') {
    const sk = character.skills.find(s => s.id === payload.id);
    if (sk && v1) sk.name = v1;
    revealedSkillId = null;
  } else if (type === 'statMeta') {
    const meta = character.statsMeta[payload.key];
    if (v1) meta.label = v1;
    if (v2) meta.icon = v2;
    revealedStat = null;
  }

  saveCharacter();
  document.getElementById('quick-edit-overlay').classList.remove('open');
  quickEditContext = null;
  renderStatus();
}

// ---- Generic confirm modal ----
let confirmCallback = null;

function openConfirmModal(message, cb) {
  confirmCallback = cb;
  document.getElementById('confirm-message').textContent = message;
  document.getElementById('confirm-overlay').classList.add('open');
}

function closeConfirmModal(e) {
  if (e && e.target !== document.getElementById('confirm-overlay')) return;
  document.getElementById('confirm-overlay').classList.remove('open');
  confirmCallback = null;
}

function confirmModalYes() {
  const cb = confirmCallback;
  document.getElementById('confirm-overlay').classList.remove('open');
  confirmCallback = null;
  if (cb) cb();
}

function saveCharacter() {
  localStorage.setItem('character', JSON.stringify(character));
}

function statValue(key) {
  return character.statsBase[key] + character.statsSpent[key];
}

function grantHabitXP(habitId, dateStr) {
  const cellKey = `${habitId}_${dateStr}`;
  if (xpAwardedCells[cellKey]) return;
  xpAwardedCells[cellKey] = true;
  localStorage.setItem('xpAwardedCells', JSON.stringify(xpAwardedCells));
  addXP(XP_PER_HABIT);
}

function addXP(amount) {
  character.xp += amount;
  let leveledUp = false;
  while (character.xp >= character.xpToNext) {
    character.xp -= character.xpToNext;
    character.level++;
    character.xpToNext = Math.round(character.xpToNext * 1.15);
    character.points += 3;
    leveledUp = true;
  }
  saveCharacter();
  renderStatus();
  if (leveledUp) {
    showToast(`🎉 Level Up! وصلت إلى المستوى ${character.level}`);
  }
}

function plusStat(key) {
  if (character.points <= 0) return;
  character.statsSpent[key]++;
  character.points--;
  saveCharacter();
  renderStatus();
}

function minusStat(key) {
  if (character.statsSpent[key] <= 0) return;
  character.statsSpent[key]--;
  character.points++;
  saveCharacter();
  renderStatus();
}

function toggleStatReveal(key) {
  revealedStat = revealedStat === key ? null : key;
  renderStatus();
}

function editStatMeta(key) {
  const meta = character.statsMeta[key];
  openQuickEdit({
    type: 'statMeta',
    payload: { key },
    title: '✏️ تعديل الخاصية',
    label1: 'اسم الخاصية',
    value1: meta.label,
    placeholder1: 'مثال: STR',
    label2: 'الأيقونة (إيموجي)',
    value2: meta.icon,
    placeholder2: 'مثال: 💪',
  });
}

function editJob() {
  openQuickEdit({
    type: 'job',
    title: '✏️ تعديل Job',
    label1: 'Job',
    value1: character.job,
    placeholder1: 'مثال: Wolf Assassin',
  });
}

function editTitle() {
  openQuickEdit({
    type: 'title',
    title: '✏️ تعديل Title',
    label1: 'Title',
    value1: character.title,
    placeholder1: 'مثال: مبتدئ',
  });
}

function toggleSkillReveal(id) {
  revealedSkillId = revealedSkillId === id ? null : id;
  renderStatus();
}

function addSkill() {
  openQuickEdit({
    type: 'addSkill',
    title: '➕ إضافة مهارة جديدة',
    label1: 'اسم المهارة',
    value1: '',
    placeholder1: 'مثال: فن اللامبالاة',
  });
}

function editSkill(id) {
  const sk = character.skills.find(s => s.id === id);
  if (!sk) return;
  openQuickEdit({
    type: 'editSkill',
    payload: { id },
    title: '✏️ تعديل المهارة',
    label1: 'اسم المهارة',
    value1: sk.name,
    placeholder1: 'اسم المهارة',
  });
}

function deleteSkillItem(id) {
  openConfirmModal('هل تريد حذف هذه المهارة؟', () => {
    character.skills = character.skills.filter(s => s.id !== id);
    saveCharacter();
    revealedSkillId = null;
    renderStatus();
    showToast('🗑 تم حذف المهارة');
  });
}

function renderStatus() {
  const levelEl = document.getElementById('status-level');
  if (!levelEl) return; // panel not present in DOM

  levelEl.textContent = character.level;
  document.getElementById('status-job').textContent = character.job;
  document.getElementById('status-title').textContent = character.title;

  // XP bar
  const xpPct = character.xpToNext > 0 ? Math.min(100, Math.round((character.xp / character.xpToNext) * 100)) : 0;
  document.getElementById('status-xp-fill').style.width = xpPct + '%';
  document.getElementById('status-xp-text').textContent = `${character.xp}/${character.xpToNext}`;

  // Stats grid — tap an item to reveal its edit (icon + name) button
  document.getElementById('status-stats-grid').innerHTML = STAT_KEYS.map(key => {
    const meta = character.statsMeta[key];
    const revealed = revealedStat === key;
    return `
    <div class="status-stat-item ${revealed ? 'revealed' : ''}" onclick="toggleStatReveal('${key}')">
      <span class="status-stat-icon">${meta.icon}</span>
      <span class="status-stat-label">${meta.label}</span>
      <span class="status-stat-value">${statValue(key)}</span>
      ${revealed ? `<button class="status-stat-edit-btn" onclick="event.stopPropagation(); editStatMeta('${key}')" title="تعديل الاسم والأيقونة">✏️</button>` : ''}
    </div>`;
  }).join('');

  // Points + distribution
  document.getElementById('status-points').textContent = character.points;
  document.getElementById('status-distribute').innerHTML = STAT_KEYS.map(key => {
    const meta = character.statsMeta[key];
    return `
    <div class="status-dist-row">
      <span class="status-dist-label">${meta.icon} ${meta.label}</span>
      <span class="status-dist-value">${statValue(key)}</span>
      <div class="status-dist-btns">
        <button class="status-dist-btn minus" onclick="minusStat('${key}')" ${character.statsSpent[key] <= 0 ? 'disabled' : ''}>−</button>
        <button class="status-dist-btn plus" onclick="plusStat('${key}')" ${character.points <= 0 ? 'disabled' : ''}>+</button>
      </div>
    </div>`;
  }).join('');

  // Skills — tap the row to reveal its edit/delete buttons
  const skillsList = document.getElementById('status-skills-list');
  skillsList.innerHTML = character.skills.map(sk => {
    const revealed = revealedSkillId === sk.id;
    return `
    <div class="status-skill-item ${revealed ? 'revealed' : ''}" onclick="toggleSkillReveal(${sk.id})">
      <span class="status-skill-name">${sk.name}</span>
      ${revealed ? `
      <div class="status-skill-actions">
        <button onclick="event.stopPropagation(); editSkill(${sk.id})" title="تعديل">✏️</button>
        <button onclick="event.stopPropagation(); deleteSkillItem(${sk.id})" title="حذف">🗑</button>
      </div>` : ''}
    </div>`;
  }).join('') || '<div class="status-skills-empty">لا توجد مهارات بعد</div>';
}

// ============ STATUS PAGE (isolated full-screen page) ============
let statusParticlesGenerated = false;

function openStatusPage() {
  renderStatus();
  const overlay = document.getElementById('status-page-overlay');
  overlay.style.display = 'flex';

  if (!statusParticlesGenerated) {
    generateStatusParticles();
    statusParticlesGenerated = true;
  }

  // Force a reflow so the opening transition actually animates
  void overlay.offsetWidth;
  overlay.classList.add('open');
  document.body.style.overflow = 'hidden';

  // Re-trigger the scanline sweep every time the page opens
  const scan = document.getElementById('status-page-scanline');
  scan.classList.remove('run');
  void scan.offsetWidth;
  scan.classList.add('run');
}

function closeStatusPage(e) {
  // If called from the backdrop click, only close when the backdrop itself was clicked
  if (e && e.target !== document.getElementById('status-page-overlay')) return;
  const overlay = document.getElementById('status-page-overlay');
  overlay.classList.remove('open');
  document.body.style.overflow = '';
  setTimeout(() => { overlay.style.display = 'none'; }, 500);
}

function generateStatusParticles() {
  const wrap = document.getElementById('status-page-particles');
  let html = '';
  for (let i = 0; i < 60; i++) {
    const left = (Math.random() * 100).toFixed(2);
    const top = (Math.random() * 100).toFixed(2);
    const size = (Math.random() * 2 + 1).toFixed(1);
    const delay = (Math.random() * 4).toFixed(2);
    const dur = (2.5 + Math.random() * 3).toFixed(2);
    html += `<span class="status-star" style="left:${left}%;top:${top}%;width:${size}px;height:${size}px;animation-delay:${delay}s;animation-duration:${dur}s;"></span>`;
  }
  wrap.innerHTML = html;
}

// ============ RENDER TABLE ============
function renderTable() {
  const dates = getWeekDates(currentWeek);
  const head = document.getElementById('table-head');
  const body = document.getElementById('table-body');
  const weekLabel = document.getElementById('week-label');

  // Week label
  const startD = dates[0];
  const endD = dates[6];
  weekLabel.textContent = `${startD.getDate()} - ${endD.getDate()} ${MONTHS_AR[endD.getMonth()]}`;

  // Head
  let headHtml = '<tr><th>العادات</th>';
  dates.forEach((d, i) => {
    const cls = isToday(d) ? 'today-col' : '';
    headHtml += `<th class="${cls}">
      <div>${DAYS_AR[i]}</div>
      <div style="font-size:13px;color:${isToday(d)?'var(--accent)':'var(--text)'};font-family:'Orbitron',monospace;">${d.getDate()}</div>
    </th>`;
  });
  headHtml += '</tr>';
  head.innerHTML = headHtml;

  // Body
  let bodyHtml = '';
  habits.forEach(h => {
    bodyHtml += `<tr draggable="true" data-habit-id="${h.id}">
      <td><div class="habit-name">
        <span class="drag-handle" title="اسحب لتغيير الترتيب">⠿</span>
        <span class="habit-emoji">${h.emoji}</span>
        <span>${h.name}</span>
        ${h.streak > 0 ? `<span class="habit-streak">🔥${h.streak}د</span>` : ''}
        <button class="edit-habit-btn" onclick="openEditModal(${h.id})" title="تعديل العادة">✏️</button>
        <button class="delete-habit-btn" onclick="deleteHabit(${h.id})" title="حذف العادة">🗑</button>
      </div></td>`;
    dates.forEach(d => {
      const ds = formatDate(d);
      const checked = getCheck(h.id, ds);
      const future = isFuture(d);
      const todayCls = isToday(d) ? 'today-check' : '';
      const futureCls = future ? 'future' : '';
      bodyHtml += `<td class="check-cell">
        <input type="checkbox" class="habit-check ${todayCls} ${futureCls}"
          ${checked ? 'checked' : ''}
          ${future ? 'disabled' : ''}
          onchange="toggleCheck(${h.id},'${ds}',this.checked)"
          title="${h.name} — ${d.getDate()} ${MONTHS_AR[d.getMonth()]}">
      </td>`;
    });
    bodyHtml += '</tr>';
  });

  // Progress row
  bodyHtml += '<tr class="progress-row"><td style="padding:16px 24px;font-size:11px;color:var(--text-muted);font-weight:700;">التقدم اليومي</td>';
  dates.forEach(d => {
    const ds = formatDate(d);
    const done = habits.filter(h => getCheck(h.id, ds)).length;
    const total = habits.length;
    const pct = total > 0 ? Math.round((done/total)*100) : 0;
    bodyHtml += `<td>
      <div class="day-progress">
        <div class="day-bar">
          <div class="day-bar-fill" id="bar-${ds}" style="height:${pct}%"></div>
        </div>
        <div class="day-pct">${pct}%</div>
      </div>
    </td>`;
  });
  bodyHtml += '</tr>';

  body.innerHTML = bodyHtml;
  updateStats();

  // ---- Drag & Drop setup ----
  setupDragAndDrop();
}

// ============ DRAG & DROP ============
let dragSrcId = null;

function setupDragAndDrop() {
  const tbody = document.getElementById('table-body');
  const rows = tbody.querySelectorAll('tr[data-habit-id]');

  rows.forEach(row => {
    row.addEventListener('dragstart', e => {
      dragSrcId = parseInt(row.dataset.habitId);
      row.classList.add('dragging');
      e.dataTransfer.effectAllowed = 'move';
    });

    row.addEventListener('dragend', () => {
      row.classList.remove('dragging');
      tbody.querySelectorAll('tr').forEach(r => {
        r.classList.remove('drag-over', 'drag-over-bottom');
      });
    });

    row.addEventListener('dragover', e => {
      e.preventDefault();
      e.dataTransfer.dropEffect = 'move';
      if (dragSrcId === parseInt(row.dataset.habitId)) return;
      tbody.querySelectorAll('tr').forEach(r => r.classList.remove('drag-over', 'drag-over-bottom'));
      const rect = row.getBoundingClientRect();
      const midY = rect.top + rect.height / 2;
      if (e.clientY < midY) {
        row.classList.add('drag-over');
      } else {
        row.classList.add('drag-over-bottom');
      }
    });

    row.addEventListener('dragleave', () => {
      row.classList.remove('drag-over', 'drag-over-bottom');
    });

    row.addEventListener('drop', e => {
      e.preventDefault();
      const targetId = parseInt(row.dataset.habitId);
      if (dragSrcId === targetId) return;

      const srcIdx = habits.findIndex(h => h.id === dragSrcId);
      const tgtIdx = habits.findIndex(h => h.id === targetId);
      if (srcIdx === -1 || tgtIdx === -1) return;

      const rect = row.getBoundingClientRect();
      const midY = rect.top + rect.height / 2;
      const insertAfter = e.clientY >= midY;

      const [moved] = habits.splice(srcIdx, 1);
      const newTgtIdx = habits.findIndex(h => h.id === targetId);
      habits.splice(insertAfter ? newTgtIdx + 1 : newTgtIdx, 0, moved);

      save();
      showToast('✅ تم تغيير ترتيب العادات');
      renderAll();
    });
  });
}

