      <input type="text" class="modal-input" id="quick-edit-input2" placeholder="">
    </div>

    <div class="modal-actions">
      <button class="btn-cancel" onclick="closeQuickEdit()">إلغاء</button>
      <button class="btn-save" onclick="saveQuickEdit()">💾 حفظ</button>
    </div>
  </div>
</div>

<!-- Generic Confirm Modal (e.g. delete skill) -->
