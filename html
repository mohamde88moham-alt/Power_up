function renderOverallStats() {
  const year = today.getFullYear(), month = today.getMonth();
  const daysInMonth = new Date(year, month + 1, 0).getDate();
  const goalPerHabit = daysInMonth;
  const totalGoal = habits.length * goalPerHabit;

  let totalDone = 0;
  for (let day = 1; day <= today.getDate(); day++) {
    const d = new Date(year, month, day);
    const ds = formatDate(d);
    habits.forEach(h => { if (getCheck(h.id, ds)) totalDone++; });
  }

  const totalLeft = Math.max(0, totalGoal - totalDone);
  const pct = totalGoal > 0 ? Math.round((totalDone / totalGoal) * 100) : 0;

  // Donut arcs
  const circumference = 2 * Math.PI * 52; // 326.73
  const doneDash = (pct / 100) * circumference;
  const leftDash = ((100 - pct) / 100) * circumference;

  const doneEl = document.getElementById('overall-donut-done');
  const leftEl = document.getElementById('overall-donut-left');
  if (doneEl) {
    doneEl.style.strokeDashoffset = circumference - doneDash;
  }
  if (leftEl) {
    // offset the left arc to start where done ends
    leftEl.style.strokeDasharray = `${leftDash} ${doneDash + 1}`;
    leftEl.style.strokeDashoffset = circumference - doneDash;
  }

  const pctEl = document.getElementById('overall-pct');
  if (pctEl) pctEl.textContent = pct + '%';

  const ovGoal = document.getElementById('ov-goal');
  const ovDone = document.getElementById('ov-done');
  const ovLeft = document.getElementById('ov-left');
  const ovStreak = document.getElementById('ov-streak');
  if (ovGoal) ovGoal.textContent = totalGoal;
  if (ovDone) ovDone.textContent = totalDone;
  if (ovLeft) ovLeft.textContent = totalLeft;
  if (ovStreak) ovStreak.textContent = today.getDate();
}

function renderAnalysisTable() {
  const tbody = document.getElementById('analysis-tbody');
  if (!tbody) return;

  const year = today.getFullYear(), month = today.getMonth();
  const daysInMonth = new Date(year, month + 1, 0).getDate();
  const daysSoFar = today.getDate();

  let rows = habits.map(h => {
    let done = 0;
    for (let day = 1; day <= daysSoFar; day++) {
      const ds = formatDate(new Date(year, month, day));
      if (getCheck(h.id, ds)) done++;
    }
    const goal = daysSoFar;
    const left = Math.max(0, goal - done);
    const pct = goal > 0 ? Math.round((done / goal) * 100) : 0;
    return { h, goal, done, left, pct };
  });

  // Sort by pct descending
  rows.sort((a, b) => b.pct - a.pct);

  const getColor = pct => pct >= 80 ? '#10b981' : pct >= 50 ? '#00c8ff' : pct >= 25 ? '#f59e0b' : '#ef4444';

  tbody.innerHTML = rows.map(r => `
    <tr>
      <td style="text-align:right;font-size:12px;font-weight:600;white-space:nowrap;padding-right:16px;">
        <span style="margin-left:6px;">${r.h.emoji}</span>${r.h.name}
      </td>
      <td><span class="an-goal">${r.goal}</span></td>
      <td><span class="an-actual">${r.done}</span></td>
      <td><span class="an-left">${r.left}</span></td>
      <td style="min-width:90px;">
        <div class="an-bar-wrap">
          <div class="an-bar">
            <div class="an-bar-fill" style="width:${r.pct}%;background:${getColor(r.pct)};box-shadow:0 0 6px ${getColor(r.pct)}55;"></div>
          </div>
        </div>
      </td>
      <td><span class="an-pct" style="color:${getColor(r.pct)};">${r.pct}%</span></td>
    </tr>
  `).join('');
}

function renderTopHabits() {
  const list = document.getElementById('top-habits-list');
  if (!list) return;

  const year = today.getFullYear(), month = today.getMonth();
  const daysSoFar = today.getDate();

  let items = habits.map(h => {
    let done = 0;
    for (let day = 1; day <= daysSoFar; day++) {
      const ds = formatDate(new Date(year, month, day));
      if (getCheck(h.id, ds)) done++;
    }
    const pct = daysSoFar > 0 ? Math.round((done / daysSoFar) * 100) : 0;
    return { h, done, pct };
  });

  items.sort((a, b) => b.pct - a.pct);
  const top = items.slice(0, 10);

  const getColor = pct => pct >= 80 ? '#10b981' : pct >= 50 ? '#00c8ff' : pct >= 25 ? '#f59e0b' : '#ef4444';
  const rankClass = i => i === 0 ? 'gold' : i === 1 ? 'silver' : i === 2 ? 'bronze' : '';

  list.innerHTML = top.map((item, i) => `
    <div class="top-habit-item">
      <div class="top-habit-rank ${rankClass(i)}">${i + 1}</div>
      <div class="top-habit-emoji">${item.h.emoji}</div>
      <div class="top-habit-name">${item.h.name}</div>
      ${item.h.streak > 0 ? `<div class="top-habit-streak">🔥${item.h.streak}</div>` : ''}
      <div class="top-habit-pct" style="color:${getColor(item.pct)};">${item.pct}%</div>
    </div>
  `).join('') || '<div style="padding:20px;text-align:center;font-size:12px;color:var(--text-muted);">أضف عادات لعرضها هنا</div>';
}

// ============ SUB-TASKS ============
let subtasks = JSON.parse(localStorage.getItem('subtasks') || 'null') || {
  1: [
    { id: 101, text: 'مراجعة أهداف اليوم', done: false, priority: 'high' },
    { id: 102, text: 'قراءة 20 صفحة', done: false, priority: 'med' },
    { id: 103, text: 'شرب 8 أكواب ماء', done: true,  priority: 'low' },
  ],
  2: [
    { id: 201, text: 'تحضير تقرير الأسبوع', done: false, priority: 'high' },
    { id: 202, text: 'التواصل مع الفريق', done: false, priority: 'med' },
    { id: 203, text: 'مراجعة الميزانية', done: true,  priority: 'low' },
  ]
};
let nextStId = 300;

function saveSubtasks() {
  localStorage.setItem('subtasks', JSON.stringify(subtasks));
}

function renderSubtasks(board) {
  const list = document.getElementById(`subtask-list-${board}`);
  const items = subtasks[board] || [];

  if (items.length === 0) {
    list.innerHTML = `
      <div class="subtask-empty">
        <div class="empty-icon">📭</div>
        <div>لا توجد مهام بعد — أضف مهمتك الأولى</div>
      </div>`;
  } else {
    const priorityLabel = { high: 'عاجل', med: 'متوسط', low: 'منخفض' };
    const priorityClass = { high: 'priority-high', med: 'priority-med', low: 'priority-low' };
    list.innerHTML = items.map(t => `
      <div class="subtask-item subtask-item-enter" id="st-item-${t.id}">
        <div class="subtask-checkbox-wrap">
          <input type="checkbox" class="subtask-checkbox"
            ${t.done ? 'checked' : ''}
            onchange="toggleSubtask(${board}, ${t.id}, this.checked)">
        </div>
        <span class="subtask-text ${t.done ? 'done' : ''}">${t.text}</span>
        <span class="subtask-priority ${priorityClass[t.priority]}">${priorityLabel[t.priority]}</span>
        <button class="subtask-delete-btn" onclick="deleteSubtask(${board}, ${t.id})">✕</button>
      </div>
    `).join('');
  }

  // Update stats
  const done = items.filter(t => t.done).length;
  const total = items.length;
  const pending = total - done;
  const pct = total > 0 ? Math.round((done / total) * 100) : 0;

  document.getElementById(`st-badge-${board}`).textContent = `${done} / ${total}`;
  document.getElementById(`st-prog-${board}`).style.width = pct + '%';
  document.getElementById(`st-done-${board}`).textContent = done;
  document.getElementById(`st-pending-${board}`).textContent = pending;
  document.getElementById(`st-pct-${board}`).textContent = pct + '%';
}

function addSubtask(board) {
  const input = document.getElementById(`st-input-${board}`);
  const priorityEl = document.getElementById(`st-priority-${board}`);
  const text = input.value.trim();
  if (!text) return;

  const newTask = { id: nextStId++, text, done: false, priority: priorityEl.value };
  if (!subtasks[board]) subtasks[board] = [];
  subtasks[board].push(newTask);
  saveSubtasks();
  renderSubtasks(board);
  input.value = '';
  input.focus();
  showToast('✅ تمت إضافة المهمة');
}

function toggleSubtask(board, id, val) {
  const t = (subtasks[board] || []).find(x => x.id === id);
  if (t) { t.done = val; saveSubtasks(); renderSubtasks(board); }
}

function deleteSubtask(board, id) {
  subtasks[board] = (subtasks[board] || []).filter(x => x.id !== id);
  saveSubtasks();
  renderSubtasks(board);
  showToast('🗑 تم حذف المهمة');
}

function renderAll() {
  calcStreaks();
  renderTable();
  renderChartBars();
  updateStats();
  renderProgressChart();
  renderOverview();
  renderSubtasks(1);
  renderSubtasks(2);
  renderStatus();
}

function showManualReset() {
  // Show confirmation for manual reset
  if (!confirm(`هل تريد إعادة تعيين بيانات الشهر الحالي وبدء من الصفر؟\n\nسيتم حذف جميع التحديدات الشهرية الحالية.`)) return;

  const currentMonthKey = getMonthKey(today);
  const lm = today.getMonth() + 1;
  const ly = today.getFullYear();
  const lastMonthDays = today.getDate(); // days so far

  let totalDone = 0, totalPossible = 0, maxStreak = 0;
  for (let day = 1; day <= lastMonthDays; day++) {
    const d = new Date(ly, lm - 1, day);
    const ds = formatDate(d);
    habits.forEach(h => {
      totalPossible++;
      if (getCheck(h.id, ds)) totalDone++;
    });
  }
  const pct = totalPossible > 0 ? Math.round((totalDone / totalPossible) * 100) : 0;

  // Save archive snapshot
  const archive = JSON.parse(localStorage.getItem('monthsArchive') || '[]');
  const existing = archive.findIndex(a => a.month === currentMonthKey);
  const entry = { month: currentMonthKey, label: `${MONTHS_AR[lm-1]} ${ly}`, totalDone, totalPossible, pct, maxStreak };
  if (existing >= 0) archive[existing] = entry; else archive.push(entry);
  localStorage.setItem('monthsArchive', JSON.stringify(archive));

  checks = {};
  localStorage.setItem('checks', JSON.stringify(checks));
  habits.forEach(h => h.streak = 0);
  save();
  showToast('🔄 تم إعادة تعيين الشهر من الصفر');
  renderAll();
}

