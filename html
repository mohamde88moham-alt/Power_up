              <span class="status-edit-hint">✏️</span>
            </div>
            <div class="status-id-row" onclick="editTitle()" title="اضغط للتعديل">
              <span class="status-id-label">Title:</span>
              <span class="status-id-value" id="status-title">مبتدئ</span>
              <span class="status-edit-hint">✏️</span>
            </div>
          </div>
        </div>

        <div class="status-xp-wrap status-reveal r2">
