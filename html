      سيتم إعادة تعيين إحصائيات الشهر، والعادات تبقى كما هي.
    </p>

    <!-- Stats summary of last month -->
    <div id="reset-summary" style="background:rgba(0,200,255,0.05);border:1px solid rgba(0,200,255,0.15);border-radius:14px;padding:16px;margin-bottom:20px;display:grid;grid-template-columns:repeat(3,1fr);gap:12px;">
      <div>
        <div style="font-family:'Orbitron',monospace;font-size:22px;font-weight:700;color:var(--accent3);" id="reset-stat-done">0</div>
        <div style="font-size:11px;color:var(--text-muted);margin-top:4px;">إجمالي المنجز</div>
      </div>
      <div>
        <div style="font-family:'Orbitron',monospace;font-size:22px;font-weight:700;color:var(--accent);" id="reset-stat-pct">0%</div>
        <div style="font-size:11px;color:var(--text-muted);margin-top:4px;">نسبة الإنجاز</div>
      </div>
      <div>
        <div style="font-family:'Orbitron',monospace;font-size:22px;font-weight:700;color:var(--accent4);" id="reset-stat-streak">0</div>
        <div style="font-size:11px;color:var(--text-muted);margin-top:4px;">أعلى سلسلة 🔥</div>
      </div>
    </div>

    <div style="font-size:12px;color:var(--text-muted);margin-bottom:20px;">
