<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>متتبع العادات اليومية — AI Powered</title>
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;600;700;900&family=Orbitron:wght@400;700;900&display=swap" rel="stylesheet">
<style>
  :root {
    --bg: #080c14;
    --surface: #0d1525;
    --surface2: #111d33;
    --border: rgba(0,200,255,0.12);
    --accent: #00c8ff;
    --accent2: #7c3aed;
    --accent3: #10b981;
    --accent4: #f59e0b;
    --danger: #ef4444;
    --text: #e2e8f0;
    --text-muted: #64748b;
    --glow: rgba(0,200,255,0.3);
    --glow2: rgba(124,58,237,0.3);
  }

  * { margin:0; padding:0; box-sizing:border-box; }

  body {
    font-family: 'Cairo', sans-serif;
    background: var(--bg);
    color: var(--text);
    min-height: 100vh;
    overflow-x: hidden;
    direction: rtl;
  }

  /* Animated background grid */
  body::before {
    content: '';
    position: fixed;
    inset: 0;
    background-image:
      linear-gradient(rgba(0,200,255,0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(0,200,255,0.03) 1px, transparent 1px);
    background-size: 40px 40px;
    pointer-events: none;
    z-index: 0;
    animation: gridMove 20s linear infinite;
  }

  @keyframes gridMove {
    0% { transform: translateY(0); }
    100% { transform: translateY(40px); }
  }

  body::after {
    content: '';
    position: fixed;
    top: -50%;
    left: -20%;
    width: 60%;
    height: 80%;
    background: radial-gradient(ellipse, rgba(0,200,255,0.05) 0%, transparent 70%);
    pointer-events: none;
    z-index: 0;
    animation: pulse 8s ease-in-out infinite alternate;
  }

  @keyframes pulse {
    0% { opacity: 0.5; transform: scale(1); }
    100% { opacity: 1; transform: scale(1.1); }
  }

  .container {
    position: relative;
    z-index: 1;
    max-width: 1400px;
    margin: 0 auto;
    padding: 20px;
  }

  /* HEADER */
  header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px 0 30px;
    border-bottom: 1px solid var(--border);
    margin-bottom: 30px;
    animation: slideDown 0.8s ease;
  }

  @keyframes slideDown {
    from { opacity: 0; transform: translateY(-30px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .logo-icon {
    width: 48px;
    height: 48px;
    background: linear-gradient(135deg, var(--accent), var(--accent2));
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 22px;
    box-shadow: 0 0 20px var(--glow);
    animation: iconPulse 3s ease-in-out infinite;
  }

  @keyframes iconPulse {
    0%, 100% { box-shadow: 0 0 20px var(--glow); }
    50% { box-shadow: 0 0 40px var(--glow), 0 0 60px rgba(124,58,237,0.2); }
  }

  .logo-text h1 {
    font-family: 'Orbitron', monospace;
    font-size: 18px;
    font-weight: 700;
    color: var(--accent);
    letter-spacing: 1px;
    text-shadow: 0 0 15px var(--glow);
  }

  .logo-text p {
    font-size: 12px;
    color: var(--text-muted);
    margin-top: 2px;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .status-start-btn {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 20px;
    border: 1px solid rgba(245,158,11,0.4);
    border-radius: 50px;
    background: linear-gradient(135deg, rgba(245,158,11,0.18), rgba(239,68,68,0.12));
    color: #fbbf24;
    font-family: 'Orbitron', monospace;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 1px;
    cursor: pointer;
    transition: all 0.3s;
    box-shadow: 0 0 18px rgba(245,158,11,0.25);
    animation: statusStartPulse 2.4s ease-in-out infinite;
  }

  .status-start-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 26px rgba(245,158,11,0.4);
    border-color: #fbbf24;
  }

  .status-start-icon { font-size: 15px; }

  @keyframes statusStartPulse {
    0%, 100% { box-shadow: 0 0 14px rgba(245,158,11,0.2); }
    50% { box-shadow: 0 0 26px rgba(245,158,11,0.45); }
  }

  .ai-badge {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    background: linear-gradient(135deg, rgba(124,58,237,0.2), rgba(0,200,255,0.1));
    border: 1px solid var(--border);
    border-radius: 50px;
    font-size: 12px;
    color: var(--accent);
    cursor: pointer;
    transition: all 0.3s;
    position: relative;
    overflow: hidden;
  }

  .ai-badge::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, transparent, rgba(0,200,255,0.1), transparent);
    transform: translateX(-100%);
    animation: shimmer 3s infinite;
  }

  @keyframes shimmer {
    100% { transform: translateX(100%); }
  }

  .ai-dot {
    width: 8px; height: 8px;
    background: var(--accent3);
    border-radius: 50%;
    animation: blink 1.5s infinite;
  }

  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.3; }
  }

  .btn {
    padding: 10px 22px;
    border: none;
    border-radius: 10px;
    font-family: 'Cairo', sans-serif;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s;
  }

  .btn-primary {
    background: linear-gradient(135deg, var(--accent), var(--accent2));
    color: #fff;
    box-shadow: 0 4px 20px var(--glow);
  }

  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 30px var(--glow);
  }

  /* STATS ROW */
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    margin-bottom: 30px;
    animation: fadeIn 1s ease 0.3s both;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .stat-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 20px;
    position: relative;
    overflow: hidden;
    transition: all 0.3s;
    cursor: default;
  }

  .stat-card:hover {
    border-color: var(--accent);
    transform: translateY(-4px);
    box-shadow: 0 20px 40px rgba(0,0,0,0.3), 0 0 30px var(--glow);
  }

  .stat-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 3px;
    background: var(--card-color, var(--accent));
    border-radius: 16px 16px 0 0;
  }

  .stat-icon {
    font-size: 28px;
    margin-bottom: 10px;
  }

  .stat-value {
    font-family: 'Orbitron', monospace;
    font-size: 32px;
    font-weight: 700;
    color: var(--card-color, var(--accent));
    text-shadow: 0 0 20px currentColor;
    line-height: 1;
    margin-bottom: 6px;
  }

  .stat-label {
    font-size: 13px;
    color: var(--text-muted);
  }

  .stat-trend {
    position: absolute;
    top: 16px;
    left: 16px;
    font-size: 11px;
    color: var(--accent3);
    background: rgba(16,185,129,0.1);
    padding: 3px 8px;
    border-radius: 50px;
    border: 1px solid rgba(16,185,129,0.2);
  }

  /* MAIN LAYOUT */
  .main-layout {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 20px;
    margin-bottom: 20px;
  }

  /* SIDEBAR */
  .sidebar {
    display: flex;
    flex-direction: column;
    gap: 16px;
    animation: fadeIn 1s ease 0.5s both;
  }

  .panel {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 20px;
    transition: all 0.3s;
  }

  .panel-title {
    font-size: 14px;
    font-weight: 700;
    color: var(--accent);
    margin-bottom: 16px;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .panel-title::before {
    content: '';
    width: 3px;
    height: 14px;
    background: var(--accent);
    border-radius: 2px;
    display: inline-block;
    box-shadow: 0 0 8px var(--accent);
  }

  /* AI Insights */
  .insight-item {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    padding: 10px;
    border-radius: 10px;
    background: rgba(0,200,255,0.03);
    border: 1px solid rgba(0,200,255,0.08);
    margin-bottom: 8px;
    transition: all 0.3s;
    cursor: pointer;
  }

  .insight-item:hover {
    background: rgba(0,200,255,0.08);
    border-color: var(--accent);
  }

  .insight-emoji { font-size: 18px; flex-shrink: 0; }

  .insight-text {
    font-size: 12px;
    color: var(--text-muted);
    line-height: 1.6;
  }

  .insight-text strong { color: var(--text); }

  /* Mini Progress Ring */
  .ring-container {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 10px 0;
    position: relative;
  }

  .ring-label {
    position: absolute;
    text-align: center;
  }

  .ring-label .ring-pct {
    font-family: 'Orbitron', monospace;
    font-size: 22px;
    font-weight: 700;
    color: var(--accent);
    text-shadow: 0 0 15px var(--glow);
  }

  .ring-label .ring-sub {
    font-size: 10px;
    color: var(--text-muted);
  }

  /* ============ STATUS / RPG PANEL ============ */
  .status-panel {
    background: linear-gradient(180deg, rgba(0,200,255,0.04), var(--surface) 40%);
  }

  .status-head {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 16px;
  }

  .status-level-badge {
    flex-shrink: 0;
    width: 64px;
    height: 64px;
    border-radius: 14px;
    border: 1px solid var(--border);
    background: linear-gradient(135deg, rgba(0,200,255,0.12), rgba(124,58,237,0.12));
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    box-shadow: 0 0 20px var(--glow);
  }

  .status-level-num {
    font-family: 'Orbitron', monospace;
    font-size: 22px;
    font-weight: 900;
    color: var(--accent);
    text-shadow: 0 0 15px var(--glow);
    line-height: 1;
  }

  .status-level-label {
    font-size: 9px;
    letter-spacing: 1px;
    color: var(--text-muted);
    margin-top: 2px;
  }

  .status-identity {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .status-id-row {
    display: flex;
    align-items: baseline;
    gap: 6px;
    cursor: pointer;
    border-radius: 6px;
    padding: 2px 4px;
    transition: background 0.2s;
  }

  .status-id-row:hover {
    background: rgba(0,200,255,0.08);
  }

  .status-id-row:hover .status-edit-hint {
    opacity: 1;
  }

  .status-id-label {
    font-size: 10px;
    color: var(--text-muted);
    flex-shrink: 0;
  }

  .status-id-value {
    font-size: 13px;
    font-weight: 700;
    color: var(--text);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .status-edit-hint {
    font-size: 10px;
    opacity: 0;
    transition: opacity 0.2s;
    margin-right: auto;
  }

  .status-bar-row {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 8px;
  }

  .status-bar-label {
    font-family: 'Orbitron', monospace;
    font-size: 10px;
    font-weight: 700;
    color: var(--text-muted);
    width: 34px;
    flex-shrink: 0;
  }

  .status-bar-track {
    flex: 1;
    height: 8px;
    border-radius: 6px;
    background: rgba(255,255,255,0.06);
    overflow: hidden;
    position: relative;
  }

  .status-bar-fill {
    height: 100%;
    border-radius: 6px;
    transition: width 0.6s ease;
  }

  .status-bar-xp { background: linear-gradient(90deg, var(--accent), var(--accent2)); box-shadow: 0 0 8px var(--glow); }

  .status-bar-value {
    font-family: 'Orbitron', monospace;
    font-size: 10px;
    color: var(--text-muted);
    flex-shrink: 0;
    min-width: 52px;
    text-align: left;
  }

  .status-xp-wrap { margin-bottom: 10px; }

  .status-divider {
    height: 1px;
    background: var(--border);
    margin: 16px 0;
  }

  .status-stats-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    margin-bottom: 16px;
  }

  .status-stat-item {
    display: flex;
    align-items: center;
    gap: 6px;
    background: rgba(0,200,255,0.03);
    border: 1px solid rgba(0,200,255,0.08);
    border-radius: 10px;
    padding: 8px 10px;
    cursor: pointer;
    transition: all 0.2s;
  }

  .status-stat-item:hover,
  .status-stat-item.revealed {
    border-color: var(--accent);
    background: rgba(0,200,255,0.08);
  }

  .status-stat-icon { font-size: 14px; }

  .status-stat-label {
    font-size: 11px;
    color: var(--text-muted);
    font-weight: 700;
  }

  .status-stat-value {
    font-family: 'Orbitron', monospace;
    font-size: 14px;
    font-weight: 700;
    color: var(--text);
    margin-right: auto;
  }

  .status-stat-edit-btn {
    background: none;
    border: none;
    cursor: pointer;
    font-size: 12px;
    opacity: 0.85;
    padding: 2px;
    flex-shrink: 0;
  }

  .status-stat-edit-btn:hover { opacity: 1; }

  .status-points-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 12px;
    color: var(--text-muted);
    margin-bottom: 10px;
  }

  .status-points-num {
    font-family: 'Orbitron', monospace;
    font-size: 16px;
    font-weight: 700;
    color: var(--accent4);
    text-shadow: 0 0 10px rgba(245,158,11,0.4);
  }

  .status-distribute {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .status-dist-row {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .status-dist-label {
    font-size: 11px;
    color: var(--text-muted);
    width: 56px;
    flex-shrink: 0;
  }

  .status-dist-value {
    font-family: 'Orbitron', monospace;
    font-size: 13px;
    font-weight: 700;
    color: var(--text);
    width: 24px;
    text-align: center;
  }

  .status-dist-btns {
    display: flex;
    gap: 6px;
    margin-right: auto;
  }

  .status-dist-btn {
    width: 24px;
    height: 24px;
    border-radius: 7px;
    border: 1px solid var(--border);
    background: rgba(255,255,255,0.03);
    color: var(--text);
    font-size: 14px;
    line-height: 1;
    cursor: pointer;
    transition: all 0.2s;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .status-dist-btn:hover:not(:disabled) {
    border-color: var(--accent);
    color: var(--accent);
    box-shadow: 0 0 10px var(--glow);
  }

  .status-dist-btn.plus:hover:not(:disabled) {
    border-color: var(--accent4);
    color: var(--accent4);
    box-shadow: 0 0 10px rgba(245,158,11,0.3);
  }

  .status-dist-btn:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  .status-skills-head {
    font-size: 12px;
    font-weight: 700;
    color: var(--text-muted);
    margin-bottom: 10px;
  }

  .status-skills-list {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-bottom: 10px;
  }

  .status-skill-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 8px 10px;
    background: rgba(255,255,255,0.03);
    border: 1px solid var(--border);
    border-radius: 10px;
    cursor: pointer;
    transition: all 0.2s;
  }

  .status-skill-item:hover,
  .status-skill-item.revealed {
    border-color: var(--accent);
    background: rgba(0,200,255,0.06);
  }

  .status-skill-name {
    font-size: 12px;
    color: var(--text);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .status-skill-actions {
    display: flex;
    gap: 4px;
    flex-shrink: 0;
  }

  .status-skill-actions button {
    background: none;
    border: none;
    cursor: pointer;
    font-size: 12px;
    opacity: 0.7;
    transition: opacity 0.2s;
    padding: 2px;
  }

  .status-skill-actions button:hover { opacity: 1; }

  .status-skills-empty {
    font-size: 11px;
    color: var(--text-muted);
    text-align: center;
    padding: 10px;
  }

  .status-add-skill-btn {
    width: 100%;
    padding: 8px;
    border-radius: 10px;
    border: 1px dashed var(--border);
    background: transparent;
    color: var(--accent);
    font-family: 'Cairo', sans-serif;
    font-size: 12px;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.2s;
  }

  .status-add-skill-btn:hover {
    background: rgba(0,200,255,0.08);
    border-color: var(--accent);
  }

  /* ============ STATUS PAGE (isolated full-screen page) ============ */
  .status-page-overlay {
    position: fixed;
    inset: 0;
    z-index: 3000;
    display: none;
    align-items: flex-start;
    justify-content: center;
    padding: 6vh 16px 40px;
    overflow-y: auto;
    background:
      radial-gradient(ellipse 60% 40% at 50% 0%, rgba(124,58,237,0.18), transparent 65%),
      rgba(3,6,12,0.93);
    backdrop-filter: blur(8px);
    opacity: 0;
    transition: opacity 0.5s ease;
  }

  .status-page-overlay.open { opacity: 1; }

  .status-page-particles {
    position: fixed;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: 0;
  }

  .status-star {
    position: absolute;
    background: #fff;
    border-radius: 50%;
    opacity: 0;
    box-shadow: 0 0 6px #fff, 0 0 2px #00c8ff;
    animation: statusStarTwinkle ease-in-out infinite;
  }

  @keyframes statusStarTwinkle {
    0%, 100% { opacity: 0; }
    50% { opacity: 0.85; }
  }

  .status-page-scanline {
    position: fixed;
    left: 0; right: 0; top: 0;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--accent), #fff, var(--accent), transparent);
    box-shadow: 0 0 20px var(--accent), 0 0 50px var(--accent);
    opacity: 0;
    pointer-events: none;
    z-index: 3001;
  }

  .status-page-scanline.run {
    animation: statusScanSweep 1.2s cubic-bezier(.2,.7,.3,1);
  }

  @keyframes statusScanSweep {
    0% { top: 0; opacity: 1; }
    85% { opacity: 0.8; }
    100% { top: 100%; opacity: 0; }
  }

  .status-page-card {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 960px;
    background: linear-gradient(180deg, rgba(14,22,39,0.97), rgba(7,11,19,0.98));
    border: 1px solid var(--border);
    border-radius: 26px;
    padding: 36px clamp(20px, 4vw, 52px) 44px;
    box-shadow:
      0 40px 100px rgba(0,0,0,0.65),
      0 0 70px rgba(0,200,255,0.14),
      inset 0 0 80px rgba(0,200,255,0.03);
    transform: scale(0.9) translateY(28px);
    opacity: 0;
    transition: transform 0.55s cubic-bezier(.2,.85,.25,1.3), opacity 0.5s ease;
  }

  .status-page-overlay.open .status-page-card {
    transform: scale(1) translateY(0);
    opacity: 1;
  }

  .status-corner {
    position: absolute;
    width: 30px;
    height: 30px;
    opacity: 0.9;
    pointer-events: none;
  }
  .status-corner.tl { top: -1px; left: -1px; border-top: 2px solid var(--accent); border-left: 2px solid var(--accent); border-radius: 14px 0 0 0; }
  .status-corner.tr { top: -1px; right: -1px; border-top: 2px solid var(--accent); border-right: 2px solid var(--accent); border-radius: 0 14px 0 0; }
  .status-corner.bl { bottom: -1px; left: -1px; border-bottom: 2px solid var(--accent); border-left: 2px solid var(--accent); border-radius: 0 0 0 14px; }
  .status-corner.br { bottom: -1px; right: -1px; border-bottom: 2px solid var(--accent); border-right: 2px solid var(--accent); border-radius: 0 0 14px 0; }

  .status-page-topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 22px;
  }

  .status-page-heading {
    font-family: 'Orbitron', monospace;
    font-size: 22px;
    font-weight: 900;
    letter-spacing: 4px;
    color: var(--accent);
    text-shadow: 0 0 20px var(--glow);
  }

  .status-page-heading span {
    display: block;
    font-family: 'Cairo', sans-serif;
    font-size: 11px;
    letter-spacing: 0;
    font-weight: 400;
    color: var(--text-muted);
    margin-top: 2px;
  }

  .status-page-back {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 9px 18px;
    border: 1px solid var(--border);
    border-radius: 50px;
    background: rgba(255,255,255,0.03);
    color: var(--text);
    font-family: 'Cairo', sans-serif;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.25s;
  }

  .status-page-back:hover {
    border-color: var(--accent);
    color: var(--accent);
    box-shadow: 0 0 14px var(--glow);
  }

  .status-page-body {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 28px;
  }

  @media (max-width: 760px) {
    .status-page-body { grid-template-columns: 1fr; }
  }

  .status-page-col {
    display: flex;
    flex-direction: column;
  }

  .status-page-skills-panel {
    background: rgba(0,200,255,0.03);
    border: 1px solid var(--border);
    border-radius: 18px;
    padding: 18px;
  }

  /* Reveal-on-open staggered animation */
  .status-reveal {
    opacity: 0;
    transform: translateY(14px);
  }

  .status-page-overlay.open .status-reveal {
    animation: statusRevealIn 0.6s ease forwards;
  }

  .status-page-overlay.open .status-reveal.r1 { animation-delay: .15s; }
  .status-page-overlay.open .status-reveal.r2 { animation-delay: .25s; }
  .status-page-overlay.open .status-reveal.r3 { animation-delay: .35s; }
  .status-page-overlay.open .status-reveal.r4 { animation-delay: .45s; }
  .status-page-overlay.open .status-reveal.r5 { animation-delay: .55s; }

  @keyframes statusRevealIn {
    to { opacity: 1; transform: translateY(0); }
  }

  /* Enlarge inner status widgets for the dedicated page */
  .status-page-card .status-level-badge { width: 88px; height: 88px; border-radius: 20px; }
  .status-page-card .status-level-num { font-size: 32px; }
  .status-page-card .status-id-value { font-size: 15px; }
  .status-page-card .status-stats-grid { grid-template-columns: repeat(2, 1fr); gap: 12px; }
  .status-page-card .status-stat-item { padding: 12px 14px; }
  .status-page-card .status-stat-icon { font-size: 17px; }
  .status-page-card .status-stat-value { font-size: 17px; }

  /* HABIT TRACKER TABLE */
  .tracker-panel {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 20px;
    overflow: hidden;
    animation: fadeIn 1s ease 0.4s both;
  }

  .tracker-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px 24px;
    border-bottom: 1px solid var(--border);
    background: linear-gradient(135deg, rgba(0,200,255,0.05), rgba(124,58,237,0.05));
  }

  .tracker-title {
    font-size: 16px;
    font-weight: 700;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .week-nav {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .week-nav button {
    width: 32px; height: 32px;
    border: 1px solid var(--border);
    background: var(--surface2);
    color: var(--text);
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.3s;
    font-size: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .week-nav button:hover {
    border-color: var(--accent);
    color: var(--accent);
    box-shadow: 0 0 10px var(--glow);
  }

  .week-label {
    font-size: 13px;
    font-weight: 600;
    color: var(--accent);
    min-width: 80px;
    text-align: center;
  }

  /* Table */
  .table-wrap {
    overflow-x: auto;
  }

  table {
    width: 100%;
    border-collapse: collapse;
  }

  thead th {
    padding: 12px 8px;
    font-size: 11px;
    font-weight: 700;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    border-bottom: 1px solid var(--border);
    text-align: center;
  }

  thead th:first-child {
    text-align: right;
    padding-right: 24px;
    min-width: 180px;
  }

  thead th.today-col {
    color: var(--accent);
    position: relative;
  }

  thead th.today-col::after {
    content: '';
    position: absolute;
    bottom: 0; left: 50%;
    transform: translateX(-50%);
    width: 20px; height: 2px;
    background: var(--accent);
    border-radius: 2px;
    box-shadow: 0 0 8px var(--accent);
  }

  tbody tr {
    border-bottom: 1px solid rgba(255,255,255,0.03);
    transition: background 0.2s;
  }

  tbody tr:hover {
    background: rgba(0,200,255,0.03);
  }

  tbody tr:last-child { border-bottom: none; }

  .habit-name {
    padding: 14px 24px 14px 8px;
    font-size: 13px;
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 10px;
    white-space: nowrap;
  }

  .habit-emoji { font-size: 16px; }

  .habit-streak {
    font-size: 10px;
    color: var(--accent4);
    background: rgba(245,158,11,0.1);
    padding: 2px 6px;
    border-radius: 50px;
    margin-right: auto;
    white-space: nowrap;
  }

  td {
    text-align: center;
    padding: 10px 8px;
    vertical-align: middle;
  }

  /* Checkbox */
  .check-cell {
    position: relative;
  }

  .habit-check {
    width: 32px; height: 32px;
    border-radius: 8px;
    border: 2px solid rgba(255,255,255,0.1);
    background: var(--surface2);
    cursor: pointer;
    appearance: none;
    -webkit-appearance: none;
    transition: all 0.2s;
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .habit-check:checked {
    background: linear-gradient(135deg, var(--accent3), #059669);
    border-color: var(--accent3);
    box-shadow: 0 0 12px rgba(16,185,129,0.4);
    animation: checkPop 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  @keyframes checkPop {
    0% { transform: scale(0.7); }
    100% { transform: scale(1); }
  }

  .habit-check:checked::after {
    content: '✓';
    color: white;
    font-size: 14px;
    font-weight: 700;
    position: absolute;
  }

  .habit-check:not(:checked)::after {
    content: '';
  }

  .habit-check.future {
    opacity: 0.3;
    cursor: not-allowed;
  }

  .habit-check.today-check {
    border-color: rgba(0,200,255,0.4);
    box-shadow: 0 0 8px rgba(0,200,255,0.2);
  }

  /* Progress bar row */
  .progress-row td {
    padding: 16px 8px 12px;
  }

  .day-progress {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
  }

  .day-bar {
    width: 4px;
    height: 40px;
    background: var(--surface2);
    border-radius: 4px;
    overflow: hidden;
    position: relative;
  }

  .day-bar-fill {
    position: absolute;
    bottom: 0; left: 0; right: 0;
    background: linear-gradient(to top, var(--accent3), var(--accent));
    border-radius: 4px;
    transition: height 0.8s cubic-bezier(0.34, 1.2, 0.64, 1);
  }

  .day-pct {
    font-family: 'Orbitron', monospace;
    font-size: 10px;
    color: var(--text-muted);
  }

  /* Add Habit */
  .add-habit-row {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 16px 24px;
    border-top: 1px solid var(--border);
    background: rgba(0,200,255,0.02);
  }

  .add-habit-input {
    flex: 1;
    background: var(--surface2);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 10px 14px;
    color: var(--text);
    font-family: 'Cairo', sans-serif;
    font-size: 13px;
    outline: none;
    transition: all 0.3s;
    direction: rtl;
  }

  .add-habit-input:focus {
    border-color: var(--accent);
    box-shadow: 0 0 15px rgba(0,200,255,0.15);
  }

  .add-habit-input::placeholder { color: var(--text-muted); }

  /* BOTTOM: Analysis + AI Chat */
  .bottom-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    animation: fadeIn 1s ease 0.7s both;
  }

  /* Analysis Chart */
  .chart-bars {
    display: flex;
    align-items: flex-end;
    gap: 6px;
    height: 100px;
    padding: 0 4px;
  }

  .chart-bar-wrap {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    height: 100%;
  }

  .chart-bar-col {
    flex: 1;
    width: 100%;
    background: var(--surface2);
    border-radius: 4px;
    overflow: hidden;
    display: flex;
    align-items: flex-end;
    position: relative;
  }

  .chart-bar-inner {
    width: 100%;
    background: linear-gradient(to top, var(--accent), rgba(0,200,255,0.3));
    border-radius: 4px;
    transition: height 1s cubic-bezier(0.34, 1.2, 0.64, 1);
    position: relative;
  }

  .chart-bar-inner::after {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 40%;
    background: linear-gradient(to bottom, rgba(255,255,255,0.2), transparent);
    border-radius: 4px 4px 0 0;
  }

  .chart-label { font-size: 10px; color: var(--text-muted); }

  /* AI CHAT */
  .ai-chat-area {
    max-height: 200px;
    overflow-y: auto;
    padding: 12px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    scrollbar-width: thin;
    scrollbar-color: var(--border) transparent;
  }

  .msg {
    padding: 10px 14px;
    border-radius: 12px;
    font-size: 12px;
    line-height: 1.6;
    max-width: 85%;
    animation: msgIn 0.3s ease;
  }

  @keyframes msgIn {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .msg.ai {
    background: linear-gradient(135deg, rgba(0,200,255,0.1), rgba(124,58,237,0.1));
    border: 1px solid rgba(0,200,255,0.15);
    color: var(--text);
    align-self: flex-start;
    border-radius: 4px 12px 12px 12px;
  }

  .msg.user {
    background: var(--surface2);
    border: 1px solid var(--border);
    color: var(--text-muted);
    align-self: flex-end;
    border-radius: 12px 4px 12px 12px;
  }

  .msg-time {
    font-size: 10px;
    color: var(--text-muted);
    margin-top: 3px;
  }

  .ai-input-row {
    display: flex;
    gap: 8px;
    margin-top: 12px;
  }

  .ai-input {
    flex: 1;
    background: var(--surface2);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 10px 14px;
    color: var(--text);
    font-family: 'Cairo', sans-serif;
    font-size: 13px;
    outline: none;
    transition: all 0.3s;
    direction: rtl;
  }

  .ai-input:focus {
    border-color: var(--accent);
    box-shadow: 0 0 15px rgba(0,200,255,0.15);
  }

  .send-btn {
    width: 40px; height: 40px;
    background: linear-gradient(135deg, var(--accent), var(--accent2));
    border: none;
    border-radius: 10px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 16px;
    transition: all 0.3s;
    box-shadow: 0 4px 15px var(--glow);
    flex-shrink: 0;
  }

  .send-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 25px var(--glow);
  }

  .send-btn:disabled {
    opacity: 0.5;
    transform: none;
    cursor: not-allowed;
  }

  /* Loading dots */
  .loading-dots span {
    display: inline-block;
    width: 6px; height: 6px;
    background: var(--accent);
    border-radius: 50%;
    margin: 0 2px;
    animation: dot 1.4s infinite;
  }
  .loading-dots span:nth-child(2) { animation-delay: 0.2s; }
  .loading-dots span:nth-child(3) { animation-delay: 0.4s; }

  @keyframes dot {
    0%, 60%, 100% { transform: translateY(0); opacity: 0.3; }
    30% { transform: translateY(-6px); opacity: 1; }
  }

  /* Month selector */
  .month-tabs {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
    margin-bottom: 12px;
  }

  .month-tab {
    padding: 4px 10px;
    border-radius: 6px;
    font-size: 11px;
    cursor: pointer;
    border: 1px solid var(--border);
    background: transparent;
    color: var(--text-muted);
    font-family: 'Cairo', sans-serif;
    transition: all 0.2s;
  }

  .month-tab.active {
    background: linear-gradient(135deg, var(--accent), var(--accent2));
    color: white;
    border-color: transparent;
    box-shadow: 0 0 10px var(--glow);
  }

  /* Notification toast */
  .toast {
    position: fixed;
    bottom: 30px;
    left: 50%;
    transform: translateX(-50%) translateY(100px);
    background: var(--surface);
    border: 1px solid var(--accent);
    border-radius: 12px;
    padding: 14px 24px;
    font-size: 13px;
    color: var(--accent);
    box-shadow: 0 20px 50px rgba(0,0,0,0.5), 0 0 30px var(--glow);
    z-index: 1000;
    transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
    white-space: nowrap;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .toast.show { transform: translateX(-50%) translateY(0); }

  /* Drag & Drop */
  .drag-handle {
    width: 24px; height: 24px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--text-muted);
    cursor: grab;
    opacity: 0;
    transition: all 0.2s;
    flex-shrink: 0;
    font-size: 14px;
    border-radius: 6px;
    user-select: none;
  }

  .drag-handle:active { cursor: grabbing; }

  tbody tr:hover .drag-handle {
    opacity: 1;
  }

  .drag-handle:hover {
    color: var(--accent);
    background: rgba(0,200,255,0.1);
  }

  tbody tr.dragging {
    opacity: 0.4;
    background: rgba(0,200,255,0.05);
  }

  tbody tr.drag-over {
    border-top: 2px solid var(--accent);
    box-shadow: 0 -2px 12px var(--glow);
  }

  tbody tr.drag-over-bottom {
    border-bottom: 2px solid var(--accent);
    box-shadow: 0 2px 12px var(--glow);
  }

  /* Responsive */
  @media (max-width: 900px) {
    .stats-grid { grid-template-columns: repeat(2, 1fr); }
    .main-layout { grid-template-columns: 1fr; }
    .bottom-layout { grid-template-columns: 1fr; }
    .sidebar { order: 2; }
  }

  /* Delete button */
  .delete-habit-btn {
    width: 26px; height: 26px;
    border: 1px solid rgba(239,68,68,0.3);
    background: rgba(239,68,68,0.08);
    color: var(--danger);
    border-radius: 7px;
    cursor: pointer;
    font-size: 13px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: all 0.2s;
    flex-shrink: 0;
    line-height: 1;
  }

  tbody tr:hover .delete-habit-btn {
    opacity: 1;
  }

  .delete-habit-btn:hover {
    background: rgba(239,68,68,0.25);
    border-color: var(--danger);
    box-shadow: 0 0 10px rgba(239,68,68,0.3);
    transform: scale(1.1);
  }

  /* Edit button */
  .edit-habit-btn {
    width: 26px; height: 26px;
    border: 1px solid rgba(0,200,255,0.3);
    background: rgba(0,200,255,0.08);
    color: var(--accent);
    border-radius: 7px;
    cursor: pointer;
    font-size: 13px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: all 0.2s;
    flex-shrink: 0;
    line-height: 1;
  }

  tbody tr:hover .edit-habit-btn {
    opacity: 1;
  }

  .edit-habit-btn:hover {
    background: rgba(0,200,255,0.2);
    border-color: var(--accent);
    box-shadow: 0 0 10px var(--glow);
    transform: scale(1.1);
  }

  /* Edit Modal */
  .modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.7);
    backdrop-filter: blur(6px);
    z-index: 3500;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s;
  }

  .modal-overlay.open {
    opacity: 1;
    pointer-events: all;
  }

  .modal {
    background: var(--surface);
    border: 1px solid rgba(0,200,255,0.25);
    border-radius: 20px;
    padding: 28px;
    width: 440px;
    max-width: 90vw;
    box-shadow: 0 30px 80px rgba(0,0,0,0.6), 0 0 40px rgba(0,200,255,0.1);
    transform: translateY(20px) scale(0.97);
    transition: transform 0.3s cubic-bezier(0.34,1.56,0.64,1);
    position: relative;
    direction: rtl;
  }

  .modal-overlay.open .modal {
    transform: translateY(0) scale(1);
  }

  .modal-title {
    font-size: 16px;
    font-weight: 700;
    color: var(--accent);
    margin-bottom: 22px;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .modal-title::before {
    content: '';
    width: 3px; height: 16px;
    background: var(--accent);
    border-radius: 2px;
    box-shadow: 0 0 8px var(--accent);
    display: inline-block;
  }

  .modal-field {
    margin-bottom: 18px;
  }

  .modal-label {
    font-size: 12px;
    font-weight: 700;
    color: var(--text-muted);
    margin-bottom: 8px;
    display: block;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .modal-input {
    width: 100%;
    background: var(--surface2);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 11px 14px;
    color: var(--text);
    font-family: 'Cairo', sans-serif;
    font-size: 14px;
    outline: none;
    transition: all 0.3s;
    direction: rtl;
  }

  .modal-input:focus {
    border-color: var(--accent);
    box-shadow: 0 0 15px rgba(0,200,255,0.15);
  }

  /* Emoji Picker */
  .emoji-grid {
    display: grid;
    grid-template-columns: repeat(8, 1fr);
    gap: 6px;
    max-height: 180px;
    overflow-y: auto;
    padding: 4px;
    scrollbar-width: thin;
    scrollbar-color: var(--border) transparent;
  }

  .emoji-btn {
    width: 36px; height: 36px;
    border: 1px solid var(--border);
    background: var(--surface2);
    border-radius: 8px;
    cursor: pointer;
    font-size: 18px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s;
  }

  .emoji-btn:hover {
    border-color: var(--accent);
    background: rgba(0,200,255,0.1);
    transform: scale(1.15);
  }

  .emoji-btn.selected {
    border-color: var(--accent);
    background: rgba(0,200,255,0.15);
    box-shadow: 0 0 10px var(--glow);
    transform: scale(1.1);
  }

  .emoji-preview {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 14px;
    background: var(--surface2);
    border: 1px solid var(--border);
    border-radius: 10px;
    margin-bottom: 10px;
    font-size: 13px;
    color: var(--text-muted);
  }

  .emoji-preview-icon { font-size: 24px; }

  .modal-actions {
    display: flex;
    gap: 10px;
    margin-top: 22px;
  }

  .btn-cancel {
    flex: 1;
    padding: 11px;
    border: 1px solid var(--border);
    background: transparent;
    border-radius: 10px;
    color: var(--text-muted);
    font-family: 'Cairo', sans-serif;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s;
  }

  .btn-cancel:hover {
    border-color: var(--text-muted);
    color: var(--text);
    background: rgba(255,255,255,0.04);
  }

  .btn-save {
    flex: 2;
    padding: 11px;
    border: none;
    border-radius: 10px;
    background: linear-gradient(135deg, var(--accent), var(--accent2));
    color: white;
    font-family: 'Cairo', sans-serif;
    font-size: 14px;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.3s;
    box-shadow: 0 4px 20px var(--glow);
  }

  .btn-save:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 30px var(--glow);
  }

  /* Emoji search */
  .emoji-search {
    width: 100%;
    background: var(--surface2);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 8px 12px;
    color: var(--text);
    font-family: 'Cairo', sans-serif;
    font-size: 12px;
    outline: none;
    margin-bottom: 8px;
    direction: rtl;
    transition: border-color 0.2s;
  }

  .emoji-search:focus { border-color: var(--accent); }

  /* ===== PROGRESS CHART SECTION ===== */
  .progress-section {
    margin-top: 24px;
    animation: fadeIn 1s ease 0.9s both;
  }

  .progress-section .panel {
    padding: 24px;
  }

  .chart-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 20px;
    flex-wrap: wrap;
    gap: 12px;
  }

  .chart-view-tabs {
    display: flex;
    gap: 6px;
    background: var(--surface2);
    padding: 4px;
    border-radius: 10px;
    border: 1px solid var(--border);
  }

  .chart-view-tab {
    padding: 6px 18px;
    border-radius: 7px;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    border: none;
    background: transparent;
    color: var(--text-muted);
    font-family: 'Cairo', sans-serif;
    transition: all 0.25s;
  }

  .chart-view-tab.active {
    background: linear-gradient(135deg, var(--accent), var(--accent2));
    color: #fff;
    box-shadow: 0 2px 12px var(--glow);
  }

  .chart-view-tab:hover:not(.active) {
    color: var(--text);
    background: rgba(255,255,255,0.05);
  }

  /* SVG Line Chart */
  .line-chart-wrap {
    position: relative;
    width: 100%;
    overflow: hidden;
  }

  .chart-svg {
    width: 100%;
    height: 220px;
    display: block;
    overflow: visible;
  }

  .chart-grid-line {
    stroke: rgba(255,255,255,0.04);
    stroke-width: 1;
  }

  .chart-axis-label {
    fill: var(--text-muted);
    font-size: 10px;
    font-family: 'Cairo', sans-serif;
  }

  .chart-line-path {
    fill: none;
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .chart-area-path {
    opacity: 0.12;
  }

  .chart-dot {
    cursor: pointer;
    transition: r 0.15s;
  }

  .chart-dot:hover { r: 6; }

  /* Chart tooltip */
  .chart-tooltip {
    position: absolute;
    background: var(--surface);
    border: 1px solid rgba(0,200,255,0.3);
    border-radius: 10px;
    padding: 8px 12px;
    font-size: 12px;
    color: var(--text);
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.2s;
    white-space: nowrap;
    box-shadow: 0 8px 24px rgba(0,0,0,0.4), 0 0 16px rgba(0,200,255,0.1);
    z-index: 10;
    transform: translate(-50%, -110%);
  }

  .chart-tooltip.visible { opacity: 1; }

  .tooltip-value {
    font-family: 'Orbitron', monospace;
    font-size: 14px;
    font-weight: 700;
    color: var(--accent);
  }

  /* Legend */
  .chart-legend {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
    margin-top: 14px;
    padding-top: 14px;
    border-top: 1px solid var(--border);
  }

  .legend-item {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 11px;
    color: var(--text-muted);
    cursor: pointer;
    transition: color 0.2s;
  }

  .legend-item:hover { color: var(--text); }

  .legend-dot {
    width: 10px; height: 10px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  /* Summary cards inside chart */
  .chart-summary {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    margin-bottom: 20px;
  }

  .chart-sum-card {
    background: var(--surface2);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 12px 16px;
    text-align: center;
    transition: all 0.3s;
    position: relative;
    overflow: hidden;
  }

  .chart-sum-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 2px;
    background: var(--sum-color, var(--accent));
    border-radius: 2px 2px 0 0;
  }

  .chart-sum-card:hover {
    border-color: rgba(0,200,255,0.3);
    transform: translateY(-2px);
  }

  .sum-label {
    font-size: 11px;
    color: var(--text-muted);
    margin-bottom: 4px;
  }

  .sum-value {
    font-family: 'Orbitron', monospace;
    font-size: 20px;
    font-weight: 700;
    color: var(--sum-color, var(--accent));
    text-shadow: 0 0 12px currentColor;
  }

  .sum-sub {
    font-size: 10px;
    color: var(--text-muted);
    margin-top: 2px;
  }

  /* Y axis labels */
  .y-labels {
    position: absolute;
    left: 0; top: 0; bottom: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    pointer-events: none;
    padding: 8px 0;
  }

  /* Scrollbar */
  ::-webkit-scrollbar { width: 6px; height: 6px; }
  ::-webkit-scrollbar-track { background: transparent; }
  ::-webkit-scrollbar-thumb { background: var(--border); border-radius: 10px; }
  ::-webkit-scrollbar-thumb:hover { background: rgba(0,200,255,0.3); }

  /* ===== OVERALL STATS + ANALYSIS SECTION ===== */
  .overview-section {
    display: grid;
    grid-template-columns: 1fr 1.6fr 1fr;
    gap: 20px;
    margin-top: 24px;
    animation: fadeIn 1s ease 1.1s both;
  }

  /* Overall Stats donut */
  .overall-stats-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 22px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    position: relative;
    overflow: hidden;
  }

  .overall-stats-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 3px;
    background: linear-gradient(90deg, var(--accent), var(--accent2));
    border-radius: 16px 16px 0 0;
  }

  .overall-title {
    font-size: 13px;
    font-weight: 700;
    color: var(--accent);
    letter-spacing: 0.5px;
    align-self: flex-start;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .overall-title::before {
    content: '';
    width: 3px; height: 14px;
    background: var(--accent);
    border-radius: 2px;
    box-shadow: 0 0 8px var(--accent);
    display: inline-block;
  }

  .donut-wrap {
    position: relative;
    width: 130px; height: 130px;
  }

  .donut-wrap svg { width: 100%; height: 100%; }

  .donut-center {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .donut-pct {
    font-family: 'Orbitron', monospace;
    font-size: 22px;
    font-weight: 700;
    color: var(--accent);
    text-shadow: 0 0 15px var(--glow);
    line-height: 1;
  }

  .donut-sub {
    font-size: 10px;
    color: var(--text-muted);
    margin-top: 2px;
  }

  .overall-meta {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    width: 100%;
  }

  .meta-item {
    background: var(--surface2);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 10px 12px;
    text-align: center;
  }

  .meta-val {
    font-family: 'Orbitron', monospace;
    font-size: 16px;
    font-weight: 700;
    color: var(--text);
    line-height: 1;
  }

  .meta-lbl {
    font-size: 10px;
    color: var(--text-muted);
    margin-top: 3px;
  }

  /* Analysis Table */
  .analysis-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 16px;
    overflow: hidden;
  }

  .analysis-head {
    padding: 16px 20px;
    background: linear-gradient(135deg, rgba(0,200,255,0.07), rgba(124,58,237,0.07));
    border-bottom: 1px solid var(--border);
    font-size: 13px;
    font-weight: 700;
    color: var(--accent);
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .analysis-head::before {
    content: '';
    width: 3px; height: 14px;
    background: var(--accent);
    border-radius: 2px;
    box-shadow: 0 0 8px var(--accent);
    display: inline-block;
  }

  .analysis-table {
    width: 100%;
    border-collapse: collapse;
  }

  .analysis-table thead th {
    padding: 9px 14px;
    font-size: 10px;
    font-weight: 700;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    border-bottom: 1px solid var(--border);
    text-align: center;
    background: rgba(0,0,0,0.2);
  }

  .analysis-table thead th:first-child { text-align: center; }

  .analysis-table tbody tr {
    border-bottom: 1px solid rgba(255,255,255,0.03);
    transition: background 0.2s;
  }

  .analysis-table tbody tr:hover { background: rgba(0,200,255,0.04); }
  .analysis-table tbody tr:last-child { border-bottom: none; }

  .analysis-table td {
    padding: 8px 14px;
    font-size: 12px;
    text-align: center;
    vertical-align: middle;
  }

  .an-goal {
    font-family: 'Orbitron', monospace;
    font-size: 11px;
    color: var(--text-muted);
  }

  .an-actual {
    font-family: 'Orbitron', monospace;
    font-size: 11px;
    color: var(--accent3);
    font-weight: 700;
  }

  .an-left {
    font-family: 'Orbitron', monospace;
    font-size: 11px;
    color: var(--accent4);
  }

  .an-bar-wrap {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .an-bar {
    flex: 1;
    height: 6px;
    background: rgba(255,255,255,0.06);
    border-radius: 6px;
    overflow: hidden;
  }

  .an-bar-fill {
    height: 100%;
    border-radius: 6px;
    transition: width 1s cubic-bezier(0.34,1.2,0.64,1);
  }

  .an-pct {
    font-family: 'Orbitron', monospace;
    font-size: 10px;
    min-width: 32px;
    text-align: right;
    font-weight: 700;
  }

  /* Top Habits Card */
  .top-habits-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 16px;
    overflow: hidden;
  }

  .top-habits-head {
    padding: 16px 20px;
    background: linear-gradient(135deg, rgba(124,58,237,0.08), rgba(0,200,255,0.05));
    border-bottom: 1px solid var(--border);
    font-size: 13px;
    font-weight: 700;
    color: var(--accent2);
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .top-habits-head::before {
    content: '';
    width: 3px; height: 14px;
    background: var(--accent2);
    border-radius: 2px;
    box-shadow: 0 0 8px var(--accent2);
    display: inline-block;
  }

  .top-habits-list {
    padding: 10px 0;
  }

  .top-habit-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 18px;
    transition: background 0.2s;
    cursor: default;
  }

  .top-habit-item:hover { background: rgba(124,58,237,0.06); }

  .top-habit-rank {
    font-family: 'Orbitron', monospace;
    font-size: 11px;
    font-weight: 700;
    color: var(--text-muted);
    min-width: 18px;
    text-align: center;
  }

  .top-habit-rank.gold { color: #f59e0b; text-shadow: 0 0 8px rgba(245,158,11,0.5); }
  .top-habit-rank.silver { color: #94a3b8; }
  .top-habit-rank.bronze { color: #cd7c54; }

  .top-habit-emoji { font-size: 15px; }

  .top-habit-name {
    flex: 1;
    font-size: 12px;
    font-weight: 600;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .top-habit-streak {
    font-family: 'Orbitron', monospace;
    font-size: 10px;
    color: var(--accent4);
    background: rgba(245,158,11,0.1);
    border: 1px solid rgba(245,158,11,0.2);
    padding: 2px 7px;
    border-radius: 50px;
    white-space: nowrap;
  }

  .top-habit-pct {
    font-family: 'Orbitron', monospace;
    font-size: 10px;
    font-weight: 700;
    min-width: 34px;
    text-align: left;
  }

  @media (max-width: 1100px) {
    .overview-section { grid-template-columns: 1fr 1fr; }
    .top-habits-card { grid-column: span 2; }
  }

  @media (max-width: 700px) {
    .overview-section { grid-template-columns: 1fr; }
    .top-habits-card { grid-column: span 1; }
  }

  /* ===== SUB-TASKS SECTION ===== */
  .subtasks-section {
    margin-top: 28px;
    animation: fadeIn 1s ease 1s both;
  }

  .subtasks-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }

  @media (max-width: 800px) {
    .subtasks-grid { grid-template-columns: 1fr; }
  }

  .subtask-board {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 20px;
    overflow: hidden;
    transition: box-shadow 0.3s;
  }

  .subtask-board:hover {
    box-shadow: 0 8px 40px rgba(0,0,0,0.3);
  }

  .subtask-board-header {
    padding: 18px 22px 14px;
    border-bottom: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
  }

  .subtask-board-title {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 14px;
    font-weight: 700;
  }

  .subtask-board-title .board-icon {
    width: 32px; height: 32px;
    border-radius: 9px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 15px;
    flex-shrink: 0;
  }

  .board-1 .board-icon { background: linear-gradient(135deg, rgba(0,200,255,0.2), rgba(0,200,255,0.05)); border: 1px solid rgba(0,200,255,0.25); }
  .board-2 .board-icon { background: linear-gradient(135deg, rgba(124,58,237,0.2), rgba(124,58,237,0.05)); border: 1px solid rgba(124,58,237,0.25); }

  .board-1 .subtask-board-header { background: linear-gradient(135deg, rgba(0,200,255,0.04), transparent); }
  .board-2 .subtask-board-header { background: linear-gradient(135deg, rgba(124,58,237,0.04), transparent); }

  .board-1 .subtask-board-title { color: var(--accent); }
  .board-2 .subtask-board-title { color: var(--accent2); }
  .board-2 .subtask-board-title::before { background: var(--accent2) !important; box-shadow: 0 0 8px var(--accent2) !important; }

  .subtask-board-title::before {
    content: '';
    width: 3px; height: 14px;
    background: var(--accent);
    border-radius: 2px;
    box-shadow: 0 0 8px var(--accent);
    display: inline-block;
  }

  .subtask-count-badge {
    font-family: 'Orbitron', monospace;
    font-size: 10px;
    font-weight: 700;
    padding: 3px 9px;
    border-radius: 50px;
    border: 1px solid;
  }

  .board-1 .subtask-count-badge { color: var(--accent); border-color: rgba(0,200,255,0.25); background: rgba(0,200,255,0.08); }
  .board-2 .subtask-count-badge { color: var(--accent2); border-color: rgba(124,58,237,0.25); background: rgba(124,58,237,0.08); }

  .subtask-progress-bar {
    height: 3px;
    background: rgba(255,255,255,0.05);
    margin: 0 22px 0;
    border-radius: 2px;
    overflow: hidden;
  }

  .subtask-progress-fill {
    height: 100%;
    border-radius: 2px;
    transition: width 0.6s cubic-bezier(0.34,1.2,0.64,1);
  }

  .board-1 .subtask-progress-fill { background: linear-gradient(90deg, var(--accent), #00e5ff); box-shadow: 0 0 8px var(--glow); }
  .board-2 .subtask-progress-fill { background: linear-gradient(90deg, var(--accent2), #a855f7); box-shadow: 0 0 8px var(--glow2); }

  .subtask-stats-row {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 10px 22px 14px;
    font-size: 11px;
    color: var(--text-muted);
    border-bottom: 1px solid var(--border);
  }

  .subtask-stat-pill {
    display: flex;
    align-items: center;
    gap: 5px;
    padding: 3px 10px;
    border-radius: 50px;
    font-size: 11px;
    font-weight: 600;
  }

  .pill-done { background: rgba(16,185,129,0.1); color: var(--accent3); border: 1px solid rgba(16,185,129,0.2); }
  .pill-pending { background: rgba(245,158,11,0.08); color: var(--accent4); border: 1px solid rgba(245,158,11,0.15); }
  .pill-pct { margin-right: auto; font-family: 'Orbitron', monospace; font-size: 11px; font-weight: 700; }

  .board-1 .pill-pct { color: var(--accent); }
  .board-2 .pill-pct { color: var(--accent2); }

  .subtask-list {
    padding: 10px 0;
    max-height: 320px;
    overflow-y: auto;
    scrollbar-width: thin;
    scrollbar-color: var(--border) transparent;
  }

  .subtask-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 22px;
    transition: background 0.2s;
    cursor: default;
    position: relative;
  }

  .subtask-item:hover { background: rgba(255,255,255,0.02); }

  .subtask-item:hover .subtask-delete-btn { opacity: 1; }

  .subtask-checkbox-wrap {
    flex-shrink: 0;
    position: relative;
    width: 20px; height: 20px;
  }

  .subtask-checkbox {
    width: 20px; height: 20px;
    border-radius: 6px;
    border: 2px solid rgba(255,255,255,0.12);
    background: var(--surface2);
    cursor: pointer;
    appearance: none;
    -webkit-appearance: none;
    transition: all 0.2s;
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .board-1 .subtask-checkbox:checked {
    background: linear-gradient(135deg, var(--accent), #0080a0);
    border-color: var(--accent);
    box-shadow: 0 0 10px rgba(0,200,255,0.35);
    animation: checkPop 0.3s cubic-bezier(0.34,1.56,0.64,1);
  }

  .board-2 .subtask-checkbox:checked {
    background: linear-gradient(135deg, var(--accent2), #5b21b6);
    border-color: var(--accent2);
    box-shadow: 0 0 10px rgba(124,58,237,0.35);
    animation: checkPop 0.3s cubic-bezier(0.34,1.56,0.64,1);
  }

  .subtask-checkbox:checked::after {
    content: '✓';
    color: white;
    font-size: 11px;
    font-weight: 700;
    position: absolute;
  }

  .subtask-text {
    flex: 1;
    font-size: 13px;
    font-weight: 500;
    color: var(--text);
    transition: all 0.3s;
    line-height: 1.4;
  }

  .subtask-text.done {
    text-decoration: line-through;
    color: var(--text-muted);
    opacity: 0.6;
  }

  .subtask-priority {
    font-size: 10px;
    padding: 2px 8px;
    border-radius: 50px;
    font-weight: 700;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .priority-high { background: rgba(239,68,68,0.12); color: #ef4444; border: 1px solid rgba(239,68,68,0.2); }
  .priority-med  { background: rgba(245,158,11,0.1);  color: var(--accent4); border: 1px solid rgba(245,158,11,0.2); }
  .priority-low  { background: rgba(16,185,129,0.1);  color: var(--accent3); border: 1px solid rgba(16,185,129,0.2); }

  .subtask-delete-btn {
    width: 22px; height: 22px;
    border: 1px solid rgba(239,68,68,0.25);
    background: rgba(239,68,68,0.06);
    color: var(--danger);
    border-radius: 6px;
    cursor: pointer;
    font-size: 11px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: all 0.2s;
    flex-shrink: 0;
  }

  .subtask-delete-btn:hover {
    background: rgba(239,68,68,0.2);
    border-color: var(--danger);
    box-shadow: 0 0 8px rgba(239,68,68,0.25);
    transform: scale(1.1);
  }

  .subtask-add-row {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 12px 22px 16px;
    border-top: 1px solid var(--border);
  }

  .subtask-input {
    flex: 1;
    background: var(--surface2);
    border: 1px solid var(--border);
    border-radius: 9px;
    padding: 9px 13px;
    color: var(--text);
    font-family: 'Cairo', sans-serif;
    font-size: 12px;
    outline: none;
    transition: all 0.3s;
    direction: rtl;
  }

  .board-1 .subtask-input:focus { border-color: var(--accent); box-shadow: 0 0 12px rgba(0,200,255,0.12); }
  .board-2 .subtask-input:focus { border-color: var(--accent2); box-shadow: 0 0 12px rgba(124,58,237,0.12); }

  .subtask-input::placeholder { color: var(--text-muted); }

  .subtask-priority-select {
    background: var(--surface2);
    border: 1px solid var(--border);
    border-radius: 9px;
    padding: 9px 10px;
    color: var(--text-muted);
    font-family: 'Cairo', sans-serif;
    font-size: 12px;
    outline: none;
    cursor: pointer;
    transition: border-color 0.2s;
    direction: rtl;
  }

  .board-1 .subtask-priority-select:focus { border-color: var(--accent); }
  .board-2 .subtask-priority-select:focus { border-color: var(--accent2); }

  .subtask-add-btn {
    width: 34px; height: 34px;
    border: none;
    border-radius: 9px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 16px;
    font-weight: 700;
    transition: all 0.3s;
    flex-shrink: 0;
    color: white;
  }

  .board-1 .subtask-add-btn {
    background: linear-gradient(135deg, var(--accent), #0080a0);
    box-shadow: 0 4px 14px rgba(0,200,255,0.3);
  }

  .board-2 .subtask-add-btn {
    background: linear-gradient(135deg, var(--accent2), #5b21b6);
    box-shadow: 0 4px 14px rgba(124,58,237,0.3);
  }

  .subtask-add-btn:hover {
    transform: translateY(-2px) scale(1.05);
  }

  .subtask-empty {
    padding: 30px 22px;
    text-align: center;
    color: var(--text-muted);
    font-size: 12px;
  }

  .subtask-empty .empty-icon {
    font-size: 28px;
    margin-bottom: 8px;
    opacity: 0.5;
  }

  .subtask-item-enter {
    animation: subtaskIn 0.3s cubic-bezier(0.34,1.4,0.64,1);
  }

  @keyframes subtaskIn {
    from { opacity: 0; transform: translateX(16px); }
    to   { opacity: 1; transform: translateX(0); }
  }
</style>
